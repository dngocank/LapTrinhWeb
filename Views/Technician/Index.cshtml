@model BTL_PTTKYC.Models.TechnicianDashboardViewModel
@{
    ViewData["Title"] = "Trung Tâm Kỹ Thuật & Bảo Hành (Technician Portal)";
    Layout = "_AdminLayout";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-tools text-primary me-2"></i>Trung Tâm Kỹ Thuật & Bảo Hành
        </h4>
        <span class="text-muted small">Quản lý tiếp nhận máy lỗi, thẩm định kỹ thuật, sửa chữa, thay thế linh kiện và bàn giao trả máy cho khách</span>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Workbench" class="btn btn-warning rounded-pill px-3 fw-bold text-dark shadow-sm">
            <i class="bi bi-laptop-fill me-1"></i>Bàn Làm Việc Kỹ Thuật (Workbench)
        </a>
        <a asp-action="Lookup" class="btn btn-outline-primary rounded-pill px-3 fw-semibold">
            <i class="bi bi-search me-1"></i>Tra Cứu IMEI / SĐT
        </a>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-3 fw-bold">
            <i class="bi bi-plus-circle me-1"></i>Lập Phiếu Tiếp Nhận Mới
        </a>
    </div>
</div>

<!-- Quick Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card border-start border-primary border-4">
            <div class="stat-icon-wrap bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-inbox-fill"></i>
            </div>
            <div>
                <span class="text-muted small d-block">Tiếp nhận mới</span>
                <h4 class="fw-bold text-dark mb-0">@Model.ReceivedCount</h4>
                <a asp-action="Tickets" asp-route-status="Received" class="small text-primary text-decoration-none">Xem phiếu mới &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card border-start border-warning border-4">
            <div class="stat-icon-wrap bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-gear-wide-connected"></i>
            </div>
            <div>
                <span class="text-muted small d-block">Đang xử lý / Sửa chữa</span>
                <h4 class="fw-bold text-dark mb-0">@(Model.DiagnosingCount + Model.ProcessingCount + Model.WaitingPartsCount)</h4>
                <span class="small text-muted">(@Model.ProcessingCount đang sửa, @Model.WaitingPartsCount chờ linh kiện)</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card border-start border-success border-4">
            <div class="stat-icon-wrap bg-success bg-opacity-10 text-success">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div>
                <span class="text-muted small d-block">Đã sửa xong (Chờ trả)</span>
                <h4 class="fw-bold text-dark mb-0">@Model.CompletedCount</h4>
                <a asp-action="Tickets" asp-route-status="Completed" class="small text-success text-decoration-none">Sẵn sàng giao khách &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card border-start border-info border-4">
            <div class="stat-icon-wrap bg-info bg-opacity-10 text-info">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <span class="text-muted small d-block">Thẻ BH đang hiệu lực</span>
                <h4 class="fw-bold text-dark mb-0">@Model.TotalWarrantiesActive</h4>
                <a asp-action="WarrantyCards" class="small text-info text-decoration-none">Xem sổ bảo hành &rarr;</a>
            </div>
        </div>
    </div>
</div>

<!-- Main Section: Active Tickets & Quick Search -->
<div class="row g-4">
    <!-- Left: List of active tickets requiring action -->
    <div class="col-lg-8">
        <div class="bg-white p-4 rounded-3 border shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Phiếu Bảo Hành Cần Xử Lý
                    </h5>
                    <span class="text-muted small">Các thiết bị đang trong quy trình kiểm tra, thẩm định và sửa chữa</span>
                </div>
                <a asp-action="Tickets" class="btn btn-sm btn-outline-secondary rounded-pill">
                    Xem tất cả (@Model.TotalTickets)
                </a>
            </div>

            @if (Model.PendingTickets.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-check-circle display-4 text-success d-block mb-2"></i>
                    <p class="mb-0 fw-semibold">Hiện tại không có thiết bị nào đang chờ xử lý!</p>
                    <span class="small">Tất cả các ca bảo hành đã được xử lý và bàn giao đúng hẹn.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã Phiếu</th>
                                <th>Khách Hàng & Thiết Bị</th>
                                <th>Lỗi Khách Báo</th>
                                <th>Hẹn Trả</th>
                                <th>Trạng Thái</th>
                                <th class="text-center">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.PendingTickets)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Detail" asp-route-id="@t.TicketId" class="fw-bold text-primary text-decoration-none">
                                            @t.TicketCode
                                        </a>
                                        <div class="small text-muted">@t.ReceiveDate.ToString("dd/MM/yyyy")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@t.CustomerName</div>
                                        <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@t.CustomerPhone</div>
                                        @if (!string.IsNullOrEmpty(t.ProductName))
                                        {
                                            <span class="badge bg-light text-dark border mt-1">@t.ProductName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(t.ImeiNumber))
                                        {
                                            <div class="font-monospace small text-secondary">IMEI: @t.ImeiNumber</div>
                                        }
                                    </td>
                                    <td style="max-width: 220px;">
                                        <div class="text-truncate small text-dark fw-semibold" title="@t.CustomerIssue">
                                            @t.CustomerIssue
                                        </div>
                                        @if (!string.IsNullOrEmpty(t.DeviceCondition))
                                        {
                                            <div class="small text-muted text-truncate" title="@t.DeviceCondition">
                                                <i class="bi bi-info-circle me-1"></i>@t.DeviceCondition
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (t.ExpectedReturnDate.HasValue)
                                        {
                                            var isOverdue = t.ExpectedReturnDate.Value < DateTime.Today;
                                            <span class="@(isOverdue ? "text-danger fw-bold" : "text-muted small")">
                                                @t.ExpectedReturnDate.Value.ToString("dd/MM/yyyy")
                                                @if (isOverdue)
                                                {
                                                    <span class="badge bg-danger ms-1">Trễ hạn</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">---</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @t.StatusBadgeClass">@t.StatusVietnamese</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Process" asp-route-id="@t.TicketId" class="btn btn-outline-warning" title="Xử lý / Sửa chữa">
                                                <i class="bi bi-wrench"></i>
                                            </a>
                                            <a asp-action="Detail" asp-route-id="@t.TicketId" class="btn btn-outline-primary" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Right: Quick IMEI Lookup & Completed Queue -->
    <div class="col-lg-4">
        <!-- Quick Lookup Card -->
        <div class="bg-white p-4 rounded-3 border shadow-sm mb-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-upc-scan text-primary me-2"></i>Tra Cứu Nhanh Bảo Hành</h6>
            <form asp-action="Lookup" method="get">
                <div class="mb-3">
                    <label class="form-label small text-muted">Nhập số IMEI, Serial hoặc SĐT khách:</label>
                    <div class="input-group">
                        <input type="text" name="query" class="form-control" placeholder="Ví dụ: 356789123456789..." required />
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </form>
            <div class="small text-muted bg-light p-2 rounded border">
                <i class="bi bi-lightbulb text-warning me-1"></i>
                Hệ thống tự động tra cứu ngày kích hoạt bảo hành, thời hạn còn lại và lịch sử các lần tiếp nhận trước đó.
            </div>
        </div>

        <!-- Recent Completed / Ready to deliver -->
        <div class="bg-white p-4 rounded-3 border shadow-sm">
            <h6 class="fw-bold mb-3 text-success"><i class="bi bi-box2-check-fill me-2"></i>Sẵn Sàng Trả Khách</h6>
            @if (Model.RecentCompletedTickets.Count == 0)
            {
                <div class="text-center py-4 text-muted small">
                    Chưa có thiết bị nào hoàn tất chờ bàn giao.
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var c in Model.RecentCompletedTickets)
                    {
                        <div class="list-group-item px-0 py-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <a asp-action="Detail" asp-route-id="@c.TicketId" class="fw-bold text-dark text-decoration-none">
                                        @c.TicketCode
                                    </a>
                                    <div class="small text-muted">@c.CustomerName - @c.CustomerPhone</div>
                                    <span class="small text-success fw-semibold">Chi phí: @c.RepairCost.ToString("N0")đ</span>
                                </div>
                                <a asp-action="Detail" asp-route-id="@c.TicketId" class="btn btn-sm btn-success rounded-pill px-3">
                                    Trả máy
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
