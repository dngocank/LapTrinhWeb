@model List<BTL_PTTKYC.Models.WarrantyTicketModel>
@{
    ViewData["Title"] = "Danh Sách Phiếu Bảo Hành & Sửa Chữa";
    Layout = "_AdminLayout";
    string currentStatus = ViewBag.CurrentStatus as string ?? "";
    string keyword = ViewBag.Keyword as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-card-checklist text-primary me-2"></i>Danh Sách Phiếu Bảo Hành & Sửa Chữa
        </h4>
        <span class="text-muted small">Quản lý toàn bộ tiến trình xử lý máy của bộ phận Kỹ thuật (@totalCount phiếu)</span>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Workbench" class="btn btn-warning rounded-pill px-3 fw-bold text-dark shadow-sm">
            <i class="bi bi-laptop-fill me-1"></i>Bàn Làm Việc Kỹ Thuật
        </a>
        <a asp-action="Lookup" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-search me-1"></i>Tra Cứu
        </a>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-3 fw-bold">
            <i class="bi bi-plus-circle me-1"></i>Lập Phiếu Tiếp Nhận
        </a>
    </div>
</div>

<!-- Filter Tabs & Search -->
<div class="bg-white p-3 rounded-3 border shadow-sm mb-4">
    <div class="row g-2 align-items-center">
        <!-- Status Tabs -->
        <div class="col-lg-8">
            <div class="d-flex flex-wrap gap-1">
                <a asp-action="Tickets" asp-route-status="" asp-route-keyword="@keyword" 
                   class="btn btn-sm rounded-pill @(string.IsNullOrEmpty(currentStatus) ? "btn-dark fw-bold" : "btn-light text-dark border")">
                    Tất cả (@totalCount)
                </a>
                <a asp-action="Tickets" asp-route-status="Received" asp-route-keyword="@keyword" 
                   class="btn btn-sm rounded-pill @(currentStatus == "Received" ? "btn-primary fw-bold" : "btn-light text-dark border")">
                    Tiếp nhận mới
                </a>
                <a asp-action="Tickets" asp-route-status="Processing" asp-route-keyword="@keyword" 
                   class="btn btn-sm rounded-pill @(currentStatus == "Processing" ? "btn-warning fw-bold text-dark" : "btn-light text-dark border")">
                    Đang sửa chữa
                </a>
                <a asp-action="Tickets" asp-route-status="WaitingParts" asp-route-keyword="@keyword" 
                   class="btn btn-sm rounded-pill @(currentStatus == "WaitingParts" ? "btn-secondary fw-bold" : "btn-light text-dark border")">
                    Chờ linh kiện
                </a>
                <a asp-action="Tickets" asp-route-status="Completed" asp-route-keyword="@keyword" 
                   class="btn btn-sm rounded-pill @(currentStatus == "Completed" ? "btn-success fw-bold" : "btn-light text-dark border")">
                    Đã sửa xong
                </a>
                <a asp-action="Tickets" asp-route-status="Delivered" asp-route-keyword="@keyword" 
                   class="btn btn-sm rounded-pill @(currentStatus == "Delivered" ? "btn-dark fw-bold" : "btn-light text-dark border")">
                    Đã trả khách
                </a>
            </div>
        </div>

        <!-- Search input -->
        <div class="col-lg-4">
            <form asp-action="Tickets" method="get" class="d-flex gap-1">
                <input type="hidden" name="status" value="@currentStatus" />
                <input type="text" name="keyword" class="form-control form-control-sm" 
                       placeholder="Mã phiếu, khách, SĐT, IMEI..." value="@keyword" />
                <button type="submit" class="btn btn-sm btn-primary px-3"><i class="bi bi-search"></i></button>
                @if (!string.IsNullOrEmpty(keyword) || !string.IsNullOrEmpty(currentStatus))
                {
                    <a asp-action="Tickets" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
                }
            </form>
        </div>
    </div>
</div>

<!-- Tickets Table -->
<div class="bg-white rounded-3 border shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 130px;">Mã Phiếu</th>
                    <th>Ngày Tiếp Nhận</th>
                    <th>Khách Hàng & Liên Hệ</th>
                    <th>Thiết Bị & Serial / IMEI</th>
                    <th>Tình Trạng / Chẩn Đoán</th>
                    <th>Kỹ Thuật Viên</th>
                    <th>Chi Phí</th>
                    <th>Trạng Thái</th>
                    <th class="text-center" style="width: 130px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-6 d-block mb-2"></i>
                            Không tìm thấy phiếu bảo hành nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Detail" asp-route-id="@t.TicketId" class="fw-bold text-primary text-decoration-none">
                                    @t.TicketCode
                                </a>
                                @if (t.WarrantyId.HasValue)
                                {
                                    <div class="small"><span class="badge bg-success-subtle text-success">Chính hãng</span></div>
                                }
                                else
                                {
                                    <div class="small"><span class="badge bg-secondary-subtle text-secondary">Dịch vụ ngoài</span></div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@t.ReceiveDate.ToString("dd/MM/yyyy")</div>
                                <span class="small text-muted">@t.ReceiveDate.ToString("HH:mm")</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@t.CustomerName</div>
                                <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@t.CustomerPhone</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(t.ProductName))
                                {
                                    <div class="fw-semibold text-dark">@t.ProductName</div>
                                }
                                else
                                {
                                    <span class="text-muted small">Thiết bị mang ngoài</span>
                                }
                                @if (!string.IsNullOrEmpty(t.ImeiNumber))
                                {
                                    <div class="font-monospace small text-primary"><i class="bi bi-upc me-1"></i>@t.ImeiNumber</div>
                                }
                            </td>
                            <td style="max-width: 250px;">
                                <div class="text-truncate small fw-semibold text-danger" title="@t.CustomerIssue">
                                    Lỗi: @t.CustomerIssue
                                </div>
                                @if (!string.IsNullOrEmpty(t.Diagnosis))
                                {
                                    <div class="text-truncate small text-muted" title="@t.Diagnosis">
                                        KT: @t.Diagnosis
                                    </div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(t.TechnicianName))
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-person-fill text-primary me-1"></i>@t.TechnicianName
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Chưa phân công</span>
                                }
                            </td>
                            <td>
                                @if (t.RepairCost > 0)
                                {
                                    <div class="fw-bold text-danger">@t.RepairCost.ToString("N0")đ</div>
                                    @if (t.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success" style="font-size: 0.68rem;"><i class="bi bi-check2 me-1"></i>Đã TT</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger" style="font-size: 0.68rem;"><i class="bi bi-clock me-1"></i>Chưa TT</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success">Miễn phí (BH)</span>
                                }
                            </td>
                            <td>
                                <span class="badge @t.StatusBadgeClass">@t.StatusVietnamese</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Detail" asp-route-id="@t.TicketId" class="btn btn-outline-primary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Process" asp-route-id="@t.TicketId" class="btn btn-outline-warning" title="Xử lý kỹ thuật">
                                        <i class="bi bi-wrench"></i>
                                    </a>
                                    <a asp-action="PrintTicket" asp-route-id="@t.TicketId" target="_blank" class="btn btn-outline-secondary" title="In phiếu">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="text-muted small">Trang @currentPage / @totalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Tickets" asp-route-page="@(currentPage - 1)" asp-route-status="@currentStatus" asp-route-keyword="@keyword">&laquo;</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Tickets" asp-route-page="@p" asp-route-status="@currentStatus" asp-route-keyword="@keyword">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Tickets" asp-route-page="@(currentPage + 1)" asp-route-status="@currentStatus" asp-route-keyword="@keyword">&raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>
