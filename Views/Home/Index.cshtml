@section Scripts {
<script>
    // 1. Stage Slider Navigation & Auto Scroll
    let stageAutoScrollTimer = null;
    let isStagePaused = false;
    const STAGE_AUTO_SCROLL_DELAY = 3000; // Tự động lướt mỗi 3 giây

    function startStageAutoScroll() {
        stopStageAutoScroll();
        stageAutoScrollTimer = setInterval(function () {
            if (isStagePaused) return;

            var track = document.getElementById('stageSliderTrack');
            if (!track) return;

            var visibleItems = track.querySelectorAll('.stage-filter-item:not([style*="display: none"])');
            if (visibleItems.length <= 1) return;

            // Tính bước nhảy theo kích thước item
            var step = visibleItems[0].offsetWidth + 12;
            var maxScroll = track.scrollWidth - track.clientWidth;

            if (track.scrollLeft >= maxScroll - 15) {
                track.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
                track.scrollBy({ left: step, behavior: 'smooth' });
            }
        }, STAGE_AUTO_SCROLL_DELAY);
    }

    function stopStageAutoScroll() {
        if (stageAutoScrollTimer) {
            clearInterval(stageAutoScrollTimer);
            stageAutoScrollTimer = null;
        }
    }

    function scrollStageSlider(direction) {
        var track = document.getElementById('stageSliderTrack');
        if (track) {
            var visibleItems = track.querySelectorAll('.stage-filter-item:not([style*="display: none"])');
            var step = (visibleItems.length > 0 ? visibleItems[0].offsetWidth + 12 : 240) * direction;
            track.scrollBy({ left: step, behavior: 'smooth' });

            // Tạm dừng tự lướt khi người dùng bấm nút thủ công
            isStagePaused = true;
            setTimeout(function() {
                isStagePaused = false;
            }, 4000);
        }
    }

    // 2. For You Slider Navigation
    function scrollForYouSlider(direction) {
        var track = document.getElementById('forYouSliderTrack');
        if (track) {
            var scrollAmount = 320 * direction;
            track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
    }

    // 3. Stage Category Pills Switching & Auto-Scroll Setup
    document.addEventListener("DOMContentLoaded", function () {
        var stageSection = document.getElementById('dealChongDeal');
        if (stageSection) {
            // Tạm dừng khi rê chuột vào để tiện xem và click
            stageSection.addEventListener('mouseenter', function () {
                isStagePaused = true;
            });
            stageSection.addEventListener('mouseleave', function () {
                isStagePaused = false;
            });
            stageSection.addEventListener('touchstart', function () {
                isStagePaused = true;
            }, { passive: true });
            stageSection.addEventListener('touchend', function () {
                setTimeout(function () { isStagePaused = false; }, 3000);
            }, { passive: true });
        }

        // Bắt đầu tự động lướt
        startStageAutoScroll();

        // Chuyển tab danh mục
        var pills = document.querySelectorAll('#stageTabsList .cps-stage-pill');
        var track = document.getElementById('stageSliderTrack');

        pills.forEach(function(pill) {
            pill.addEventListener('click', function() {
                pills.forEach(function(p) { p.classList.remove('active'); });
                this.classList.add('active');
                var filter = this.getAttribute('data-stage-filter');
                var items = document.querySelectorAll('#stageSliderTrack .stage-filter-item');
                
                items.forEach(function(item) {
                    var tags = (item.getAttribute('data-tags') || '').split(' ');
                    if (filter === 'all' || tags.indexOf(filter) !== -1) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });

                if (track) {
                    track.scrollTo({ left: 0, behavior: 'smooth' });
                }

                // Kích hoạt lại luồng lướt tự động ngay cho danh mục mới
                isStagePaused = false;
                startStageAutoScroll();
            });
        });
    });

    // 6. Realtime 4-Digit Countdown Timer (Ngày : Giờ : Phút : Giây)
    (function initCountdown() {
        var targetDate = new Date();
        targetDate.setHours(23, 59, 59, 999);
        targetDate.setDate(targetDate.getDate() + 1);

        function updateCountdown() {
            var now = new Date().getTime();
            var diff = targetDate.getTime() - now;

            if (diff <= 0) {
                diff = 24 * 3600 * 1000;
            }

            var days = Math.floor(diff / (1000 * 60 * 60 * 24));
            var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            var mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            var secs = Math.floor((diff % (1000 * 60)) / 1000);

            var elD = document.getElementById('stageCdDay');
            var elH = document.getElementById('stageCdHour');
            var elM = document.getElementById('stageCdMin');
            var elS = document.getElementById('stageCdSec');

            if (elD) elD.textContent = String(days).padStart(2, '0');
            if (elH) elH.textContent = String(hours).padStart(2, '0');
            if (elM) elM.textContent = String(mins).padStart(2, '0');
            if (elS) elS.textContent = String(secs).padStart(2, '0');
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    })();

    // 7. Interactive Trade-In Calculator
    function calculateTradeIn() {
        var oldVal = parseFloat(document.getElementById('tradeOldDevice')?.value || 21500000);
        var condMult = parseFloat(document.getElementById('tradeCondition')?.value || 1.0);
        var newVal = parseFloat(document.getElementById('tradeNewDevice')?.value || 41990000);

        var actualOldPrice = Math.round(oldVal * condMult);
        var subsidy = 2500000;
        var totalDeduct = actualOldPrice + subsidy;
        var payMore = Math.max(0, newVal - totalDeduct);

        function fmt(n) {
            return n.toLocaleString('vi-VN') + 'đ';
        }

        var elOld = document.getElementById('tradeOldPrice');
        var elDeduct = document.getElementById('tradeTotalDeduct');
        var elPay = document.getElementById('tradePayMore');

        if (elOld) elOld.textContent = fmt(actualOldPrice);
        if (elDeduct) elDeduct.textContent = fmt(totalDeduct);
        if (elPay) elPay.textContent = fmt(payMore);
    }
</script>
}
