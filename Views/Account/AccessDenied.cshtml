@{
    ViewData["Title"] = "Từ Chối Quyền Truy Cập";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="p-5 bg-white rounded-4 border shadow-sm">
                <i class="bi bi-shield-x text-danger display-1 mb-3"></i>
                <h3 class="fw-bold mb-2">Từ Chối Quyền Truy Cập (403)</h3>
                <p class="text-muted mb-4">Tài khoản của bạn không có quyền truy cập vào chức năng hoặc trang này.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house me-1"></i>Trang chủ
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập tài khoản khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
