@{
    ViewData["Title"] = "Trung tâm Thông tin & Chính sách khách hàng | KittyPhone";
    string activeTab = ViewBag.ActiveTab as string ?? "online-payment";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Thông tin & Chính sách</li>
        </ol>
    </nav>

    <!-- Header Banner -->
    <div class="bg-primary text-white rounded-4 p-4 p-md-5 mb-4 shadow-sm" style="background: linear-gradient(135deg, #0e2254 0%, #1d4ed8 100%) !important;">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">
                    <i class="bi bi-shield-check me-1"></i>TRUNG TÂM HỖ TRỢ KHÁCH HÀNG KITTYPHONE
                </span>
                <h2 class="fw-bold mb-2">Quy định, Chính sách & Dịch vụ khách hàng</h2>
                <p class="text-white-50 mb-0">
                    Minh bạch tuyệt đối về chính sách bảo hành, phương thức thanh toán an toàn, quy định giao nhận và quyền lợi mua sắm dành cho KittyMember.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <div class="bg-white bg-opacity-10 border border-white border-opacity-25 rounded-3 p-3 text-start d-inline-block">
                    <div class="small text-white-50"><i class="bi bi-telephone-inbound me-1"></i>Tổng đài hỗ trợ 24/7</div>
                    <div class="fs-5 fw-bold text-warning">0396.166.509</div>
                    <div class="small text-white-50">Email: cskh@kittyphone.vn</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content: Tabs and Details -->
    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-4 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden sticky-top" style="top: 90px;">
                <div class="p-3 bg-light border-bottom">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-list-nested me-2 text-primary"></i>Danh mục chính sách
                    </h6>
                </div>
                <div class="nav flex-column nav-pills p-2" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                    <!-- Nhóm 1 -->
                    <div class="px-2 pt-2 pb-1 text-muted fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">
                        Thông tin & Chính sách
                    </div>
                    <button class="nav-link text-start rounded-2 py-2 mb-1 @(activeTab == "online-payment" ? "active" : "")" 
                            id="tab-online-payment" data-bs-toggle="pill" data-bs-target="#pane-online-payment" type="button" role="tab">
                        <i class="bi bi-credit-card-2-front me-2"></i>Mua hàng & Thanh toán Online
                    </button>
                    <button class="nav-link text-start rounded-2 py-2 mb-1 @(activeTab == "installment-0" ? "active" : "")" 
                            id="tab-installment-0" data-bs-toggle="pill" data-bs-target="#pane-installment-0" type="button" role="tab">
                        <i class="bi bi-percent me-2"></i>Trả góp 0% qua thẻ tín dụng
                    </button>
                    <button class="nav-link text-start rounded-2 py-2 mb-1 @(activeTab == "shipping-inspection" ? "active" : "")" 
                            id="tab-shipping-inspection" data-bs-toggle="pill" data-bs-target="#pane-shipping-inspection" type="button" role="tab">
                        <i class="bi bi-truck me-2"></i>Giao hàng & Kiểm hàng
                    </button>
                    <button class="nav-link text-start rounded-2 py-2 mb-1 @(activeTab == "warranty-30days" ? "active" : "")" 
                            id="tab-warranty-30days" data-bs-toggle="pill" data-bs-target="#pane-warranty-30days" type="button" role="tab">
                        <i class="bi bi-arrow-repeat me-2"></i>Bảo hành 1 đổi 1 trong 30 ngày
                    </button>
                    <button class="nav-link text-start rounded-2 py-2 mb-1 @(activeTab == "vat-invoice" ? "active" : "")" 
                            id="tab-vat-invoice" data-bs-toggle="pill" data-bs-target="#pane-vat-invoice" type="button" role="tab">
                        <i class="bi bi-receipt me-2"></i>Tra cứu hóa đơn điện tử VAT
                    </button>
                    <button class="nav-link text-start rounded-2 py-2 mb-1 @(activeTab == "privacy-policy" ? "active" : "")" 
                            id="tab-privacy-policy" data-bs-toggle="pill" data-bs-target="#pane-privacy-policy" type="button" role="tab">
                        <i class="bi bi-shield-lock me-2"></i>Bảo vệ thông tin khách hàng
                    </button>

                    <!-- Nhóm 2 -->
                    <div class="px-2 pt-3 pb-1 text-muted fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">
                        Dịch vụ & Thông tin khác
                    </div>
                    <button class="nav-link text-start rounded-2 py-2 mb-1 @(activeTab == "b2b-corporate" ? "active" : "")" 
                            id="tab-b2b-corporate" data-bs-toggle="pill" data-bs-target="#pane-b2b-corporate" type="button" role="tab">
                        <i class="bi bi-building me-2"></i>Khách hàng doanh nghiệp (B2B)
                    </button>
                    <button class="nav-link text-start rounded-2 py-2 mb-1 @(activeTab == "bank-partners" ? "active" : "")" 
                            id="tab-bank-partners" data-bs-toggle="pill" data-bs-target="#pane-bank-partners" type="button" role="tab">
                        <i class="bi bi-tags me-2"></i>Ưu đãi thanh toán & Đối tác
                    </button>
                    <button class="nav-link text-start rounded-2 py-2 mb-1 @(activeTab == "ecommerce-regulation" ? "active" : "")" 
                            id="tab-ecommerce-regulation" data-bs-toggle="pill" data-bs-target="#pane-ecommerce-regulation" type="button" role="tab">
                        <i class="bi bi-file-earmark-ruled me-2"></i>Quy chế hoạt động sàn TMĐT
                    </button>
                    <button class="nav-link text-start rounded-2 py-2 mb-1 @(activeTab == "trade-in-subsidy" ? "active" : "")" 
                            id="tab-trade-in-subsidy" data-bs-toggle="pill" data-bs-target="#pane-trade-in-subsidy" type="button" role="tab">
                        <i class="bi bi-recycle me-2"></i>Thu cũ đổi mới trợ giá 2.5Tr
                    </button>
                    <button class="nav-link text-start rounded-2 py-2 mb-1 @(activeTab == "recruitment" ? "active" : "")" 
                            id="tab-recruitment" data-bs-toggle="pill" data-bs-target="#pane-recruitment" type="button" role="tab">
                        <i class="bi bi-briefcase me-2"></i>Tuyển dụng nhân viên mới nhất
                    </button>
                </div>
            </div>
        </div>

        <!-- Detail Content Pane -->
        <div class="col-lg-8 col-xl-9">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white tab-content" id="v-pills-tabContent">
                
                <!-- 1. Mua hàng và thanh toán Online -->
                <div class="tab-pane fade @(activeTab == "online-payment" ? "show active" : "")" id="pane-online-payment" role="tabpanel">
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                            <i class="bi bi-credit-card-2-front fs-3"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-1 text-dark">Chính sách Mua hàng & Thanh toán Online</h3>
                            <div class="text-muted small">Cập nhật áp dụng cho toàn bộ hệ thống KittyPhone Việt Nam</div>
                        </div>
                    </div>

                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-1-circle-fill me-2"></i>Quy trình 4 bước đặt hàng trực tuyến</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-xl-3">
                            <div class="border rounded-3 p-3 h-100 bg-light">
                                <span class="badge bg-primary mb-2">Bước 1</span>
                                <h6 class="fw-bold mb-1">Chọn sản phẩm</h6>
                                <p class="text-muted small mb-0">Tìm kiếm model, chọn phiên bản bộ nhớ, màu sắc và bấm "Thêm vào giỏ" hoặc "Mua ngay".</p>
                            </div>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <div class="border rounded-3 p-3 h-100 bg-light">
                                <span class="badge bg-primary mb-2">Bước 2</span>
                                <h6 class="fw-bold mb-1">Thông tin giao nhận</h6>
                                <p class="text-muted small mb-0">Điền họ tên người nhận, số điện thoại, địa chỉ nhận hàng và ghi chú (nếu có).</p>
                            </div>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <div class="border rounded-3 p-3 h-100 bg-light">
                                <span class="badge bg-primary mb-2">Bước 3</span>
                                <h6 class="fw-bold mb-1">Chọn thanh toán</h6>
                                <p class="text-muted small mb-0">Chọn VNPAY, MoMo, Chuyển khoản VietQR, Thẻ Visa/Master hoặc Thanh toán khi nhận (COD).</p>
                            </div>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <div class="border rounded-3 p-3 h-100 bg-light">
                                <span class="badge bg-primary mb-2">Bước 4</span>
                                <h6 class="fw-bold mb-1">Xác nhận & Giao hàng</h6>
                                <p class="text-muted small mb-0">Hệ thống tạo mã đơn hàng, nhân viên xác nhận và điều phối giao siêu tốc 2 Giờ.</p>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-wallet2 me-2"></i>Các phương thức thanh toán được hỗ trợ</h5>
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item px-0 py-3 d-flex align-items-start gap-3">
                            <span class="badge bg-danger rounded-pill p-2"><i class="bi bi-qr-code fs-6"></i></span>
                            <div>
                                <strong class="text-dark">Quét mã QR qua Cổng VNPAY / VietQR (Napas247)</strong>
                                <p class="text-muted small mb-0">Hỗ trợ quét trực tiếp trên hơn 40 ứng dụng Mobile Banking của tất cả ngân hàng tại Việt Nam. Tiền về ngay tức thì và xác nhận đơn tự động.</p>
                            </div>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex align-items-start gap-3">
                            <span class="badge bg-success rounded-pill p-2"><i class="bi bi-phone fs-6"></i></span>
                            <div>
                                <strong class="text-dark">Ví điện tử MoMo / ZaloPay / Kredivo</strong>
                                <p class="text-muted small mb-0">Thanh toán nhanh chóng không cần nhập số thẻ, tích lũy điểm thưởng và hỗ trợ Ví trả sau MoMo / Kredivo 0% lãi suất.</p>
                            </div>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex align-items-start gap-3">
                            <span class="badge bg-primary rounded-pill p-2"><i class="bi bi-credit-card fs-6"></i></span>
                            <div>
                                <strong class="text-dark">Thẻ tín dụng / Thẻ ghi nợ Quốc tế (Visa, MasterCard, JCB)</strong>
                                <p class="text-muted small mb-0">Bảo mật chuẩn quốc tế 3D-Secure qua cổng thanh toán bảo mật SSL 256-bit, không lưu trữ thông tin CVV/CVC.</p>
                            </div>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex align-items-start gap-3">
                            <span class="badge bg-secondary rounded-pill p-2"><i class="bi bi-cash-stack fs-6"></i></span>
                            <div>
                                <strong class="text-dark">Thanh toán khi nhận hàng (COD)</strong>
                                <p class="text-muted small mb-0">Khách hàng kiểm tra máy đúng model, số serial nguyên seal mới thanh toán tiền mặt hoặc chuyển khoản cho shipper (áp dụng đơn dưới 20 triệu đồng).</p>
                            </div>
                        </li>
                    </ul>

                    <div class="alert alert-info border-0 rounded-3 mb-0">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Cam kết an toàn:</strong> KittyPhone không thu thêm bất kỳ phí phụ thu thanh toán thẻ nào (0% surcharge). Mọi giao dịch đều có hóa đơn VAT hợp pháp.
                    </div>
                </div>

                <!-- 2. Trả góp 0% qua thẻ tín dụng -->
                <div class="tab-pane fade @(activeTab == "installment-0" ? "show active" : "")" id="pane-installment-0" role="tabpanel">
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="rounded-circle bg-warning-subtle text-warning p-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                            <i class="bi bi-percent fs-3 text-dark"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-1 text-dark">Chính sách Trả góp 0% Lãi suất qua Thẻ tín dụng</h3>
                            <div class="text-muted small">Sở hữu ngay Flagship không cần thanh toán hết một lần</div>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light text-center h-100">
                                <i class="bi bi-shield-check text-success fs-1 mb-2"></i>
                                <h6 class="fw-bold">0% Lãi suất cố định</h6>
                                <p class="small text-muted mb-0">Khách hàng chỉ trả đúng số tiền chia đều theo kỳ hạn, không phát sinh lãi mẹ đẻ lãi con.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light text-center h-100">
                                <i class="bi bi-lightning-charge text-warning fs-1 mb-2"></i>
                                <h6 class="fw-bold">Duyệt 100% Online trong 3 phút</h6>
                                <p class="small text-muted mb-0">Không cần nộp hộ khẩu, CMND công chứng hay chứng minh bảng lương phức tạp.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light text-center h-100">
                                <i class="bi bi-calendar3 text-primary fs-1 mb-2"></i>
                                <h6 class="fw-bold">Kỳ hạn linh hoạt 3 - 12 tháng</h6>
                                <p class="small text-muted mb-0">Lựa chọn kỳ hạn 3, 6, 9 hoặc 12 tháng tùy thuộc vào khả năng tài chính của bạn.</p>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mb-3">Danh sách ngân hàng liên kết hỗ trợ trả góp:</h5>
                    <p class="text-muted small mb-3">Hệ thống KittyPhone hỗ trợ hơn 25 ngân hàng và tổ chức tài chính lớn tại Việt Nam:</p>
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <span class="badge bg-light text-dark border px-3 py-2">Techcombank</span>
                        <span class="badge bg-light text-dark border px-3 py-2">Vietcombank</span>
                        <span class="badge bg-light text-dark border px-3 py-2">VPBank</span>
                        <span class="badge bg-light text-dark border px-3 py-2">MB Bank</span>
                        <span class="badge bg-light text-dark border px-3 py-2">Sacombank</span>
                        <span class="badge bg-light text-dark border px-3 py-2">ACB</span>
                        <span class="badge bg-light text-dark border px-3 py-2">TPBank</span>
                        <span class="badge bg-light text-dark border px-3 py-2">VIB</span>
                        <span class="badge bg-light text-dark border px-3 py-2">HSBC</span>
                        <span class="badge bg-light text-dark border px-3 py-2">Shinhan Bank</span>
                        <span class="badge bg-light text-dark border px-3 py-2">Standard Chartered</span>
                    </div>

                    <div class="alert alert-warning border-0 rounded-3">
                        <h6 class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Điều kiện áp dụng:</h6>
                        <ul class="mb-0 small ps-3">
                            <li>Chủ sở hữu thẻ tín dụng quốc tế (Credit Card) còn hạn mức khả dụng bằng hoặc lớn hơn giá trị đơn hàng.</li>
                            <li>Đơn hàng có giá trị tối thiểu từ 3.000.000đ trở lên.</li>
                            <li>Có thể kết hợp hình thức Trả góp 0% cùng chương trình <strong>Thu cũ đổi mới trợ giá 2.5Tr</strong>.</li>
                        </ul>
                    </div>
                </div>

                <!-- 3. Chính sách giao hàng & kiểm hàng -->
                <div class="tab-pane fade @(activeTab == "shipping-inspection" ? "show active" : "")" id="pane-shipping-inspection" role="tabpanel">
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="rounded-circle bg-info-subtle text-info p-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                            <i class="bi bi-truck fs-3 text-primary"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-1 text-dark">Chính sách Giao hàng & Đồng kiểm hàng</h3>
                            <div class="text-muted small">An tâm nhận hàng đúng hẹn, an toàn tuyệt đối trên mọi miền tổ quốc</div>
                        </div>
                    </div>

                    <h5 class="fw-bold text-primary mb-3">1. Thời gian giao hàng</h5>
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Khu vực giao hàng</th>
                                    <th>Phương thức</th>
                                    <th>Thời gian dự kiến</th>
                                    <th>Chi phí</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold">Nội thành TP. Hồ Chí Minh</td>
                                    <td><span class="badge bg-danger">KittyPhone 2H</span></td>
                                    <td>Trong vòng <strong>2 giờ</strong> kể từ khi đặt hàng</td>
                                    <td class="text-success fw-bold">Miễn phí</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Ngoại thành TP.HCM & Các tỉnh lân cận</td>
                                    <td>Giao nhanh trong ngày</td>
                                    <td>4 - 8 giờ làm việc</td>
                                    <td class="text-success fw-bold">Miễn phí đơn từ 1.000.000đ</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Toàn quốc (Hà Nội, Đà Nẵng, Cần Thơ,...)</td>
                                    <td>Chuyển phát Viettel Post / GHTK</td>
                                    <td>1 - 3 ngày làm việc</td>
                                    <td class="text-success fw-bold">Miễn phí toàn quốc</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h5 class="fw-bold text-primary mb-3">2. Quy định Đồng kiểm hàng (Quan trọng)</h5>
                    <div class="p-3 border rounded-3 bg-light mb-4">
                        <p class="mb-2"><strong>Quyền lợi của quý khách:</strong> Khi shipper giao hàng tới, quý khách có toàn quyền <strong>đồng kiểm ngoại quan</strong> trước khi ký nhận và thanh toán:</p>
                        <ul class="mb-2 small">
                            <li>Kiểm tra bao bì còn nguyên vẹn, tem niêm phong chống mở (Seal KittyPhone) còn nguyên trạng.</li>
                            <li>Kiểm tra hộp máy không bị rách nát, móp méo hay ướt nước.</li>
                            <li>Đối chiếu đúng mã sản phẩm, model, màu sắc và dung lượng đã đặt trong đơn hàng.</li>
                        </ul>
                        <p class="mb-0 text-danger small"><strong>Lưu ý:</strong> Quý khách không tự ý cắm sạc hoặc kích hoạt active máy trước khi thanh toán. Nếu phát hiện hộp hàng có dấu hiệu bị cạy phá hoặc sai sản phẩm, quý khách có quyền từ chối nhận hàng ngay lập tức và gọi hotline <strong>0396.166.509</strong> để được đổi đơn mới.</p>
                    </div>
                </div>

                <!-- 4. Bảo hành 1 đổi 1 trong 30 ngày -->
                <div class="tab-pane fade @(activeTab == "warranty-30days" ? "show active" : "")" id="pane-warranty-30days" role="tabpanel">
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="rounded-circle bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                            <i class="bi bi-shield-fill-check fs-3"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-1 text-dark">Chính sách Bảo hành 1 đổi 1 trong 30 ngày</h3>
                            <div class="text-muted small">Cam kết chất lượng chuẩn chính hãng Apple, Samsung, Xiaomi,...</div>
                        </div>
                    </div>

