@model List<BTL_PTTKYC.Models.InvoiceModel>
@{
    ViewData["Title"] = "Đơn Hàng Của Tôi | KittyPhone";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-secondary"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Profile" class="text-secondary">KittyMember</a></li>
            <li class="breadcrumb-item active" aria-current="page">Lịch sử đơn hàng</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-receipt text-primary me-2"></i>Đơn Hàng Của Tôi</h4>
            <span class="text-muted small">Theo dõi tình trạng đơn hàng, lịch sử thanh toán và bảo hành thiết bị</span>
        </div>
        <a asp-controller="Customer" asp-action="Profile" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">
            <i class="bi bi-person me-1"></i>Về tài khoản KittyMember
        </a>
    </div>

    <div class="bg-white rounded-3 border shadow-sm p-4">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-bag-x display-5 d-block mb-3 text-secondary"></i>
                <h6 class="fw-bold text-dark">Bạn chưa có đơn hàng nào</h6>
                <p class="small text-muted mb-3">Tất cả đơn hàng bạn đặt tại KittyPhone sẽ hiển thị chi tiết tại đây.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill btn-sm px-4 fw-bold" style="background: linear-gradient(135deg, #0e2254, #0284c7); border: none;">
                    <i class="bi bi-phone me-1"></i>Khám phá deal hot ngay
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Đơn</th>
                            <th>Ngày Đặt</th>
                            <th>Địa Chỉ Nhận Hàng</th>
                            <th>Tổng Tiền</th>
                            <th>Thanh Toán</th>
                            <th>Trạng Thái</th>
                            <th class="text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>
                                    <strong class="text-primary font-monospace">#@order.InvoiceId</strong>
                                </td>
                                <td>@order.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="small text-muted text-truncate d-inline-block" style="max-width: 220px;">
                                        @(order.ShippingAddress ?? "Nhận tại cửa hàng KittyPhone")
                                    </span>
                                </td>
                                <td>
                                    <strong class="text-primary">@order.TotalAmount.ToString("N0") đ</strong>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(order.PaymentMethodSelected ?? "COD")
                                    </span>
                                </td>
                                <td>
                                    @if (order.Status == "Paid")
                                    {
                                        <span class="badge bg-success rounded-pill px-2 py-1"><i class="bi bi-check-all me-1"></i>Đã thanh toán đủ</span>
                                    }
                                    else if (order.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1"><i class="bi bi-clock-history me-1"></i>Chờ Sale phê duyệt</span>
                                    }
                                    else if (order.Status == "CancelRequested")
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1"><i class="bi bi-clock me-1"></i>Chờ duyệt hủy</span>
                                    }
                                    else if (order.Status == "Cancelled")
                                    {
                                        <span class="badge bg-secondary rounded-pill px-2 py-1">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark rounded-pill px-2 py-1">@order.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Cart" asp-action="Confirmation" asp-route-id="@order.InvoiceId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
