@model List<BTL_PTTKYC.Models.WarrantyCardModel>
@{
    ViewData["Title"] = "Sổ Thẻ Bảo Hành Hệ Thống";
    Layout = "_AdminLayout";
    string currentStatus = ViewBag.CurrentStatus as string ?? "";
    string currentKeyword = ViewBag.CurrentKeyword as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-shield-check text-primary me-2"></i>Sổ Thẻ Bảo Hành Sản Phẩm
        </h4>
        <span class="text-muted small">Toàn bộ hợp đồng & thẻ bảo hành điện tử đã kích hoạt cho sản phẩm bán ra</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Lookup" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-search me-1"></i>Tra Cứu IMEI
        </a>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold">
            <i class="bi bi-plus-circle me-1"></i>Tiếp Nhận Bảo Hành
        </a>
    </div>
</div>

<!-- Filters -->
<div class="bg-white p-3 rounded-3 border shadow-sm mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-lg-7">
            <div class="d-flex flex-wrap gap-1">
                <a asp-action="WarrantyCards" asp-route-status="" asp-route-keyword="@currentKeyword" 
                   class="btn btn-sm rounded-pill @(string.IsNullOrEmpty(currentStatus) ? "btn-dark fw-bold" : "btn-light text-dark border")">
                    Tất cả thẻ (@Model.Count)
                </a>
                <a asp-action="WarrantyCards" asp-route-status="Active" asp-route-keyword="@currentKeyword" 
                   class="btn btn-sm rounded-pill @(currentStatus == "Active" ? "btn-success fw-bold" : "btn-light text-dark border")">
                    Đang còn hạn
                </a>
                <a asp-action="WarrantyCards" asp-route-status="Expired" asp-route-keyword="@currentKeyword" 
                   class="btn btn-sm rounded-pill @(currentStatus == "Expired" ? "btn-danger fw-bold" : "btn-light text-dark border")">
                    Đã hết hạn
                </a>
                <a asp-action="WarrantyCards" asp-route-status="Claimed" asp-route-keyword="@currentKeyword" 
                   class="btn btn-sm rounded-pill @(currentStatus == "Claimed" ? "btn-warning text-dark fw-bold" : "btn-light text-dark border")">
                    Đã qua bảo hành
                </a>
            </div>
        </div>

        <div class="col-lg-5">
            <form asp-action="WarrantyCards" method="get" class="d-flex gap-1">
                <input type="hidden" name="status" value="@currentStatus" />
                <input type="text" name="keyword" class="form-control form-control-sm" 
                       placeholder="Sản phẩm, IMEI, khách hàng, SĐT..." value="@currentKeyword" />
                <button type="submit" class="btn btn-sm btn-primary px-3"><i class="bi bi-search"></i></button>
                @if (!string.IsNullOrEmpty(currentKeyword) || !string.IsNullOrEmpty(currentStatus))
                {
                    <a asp-action="WarrantyCards" class="btn btn-sm btn-outline-secondary" title="Xóa bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
                }
            </form>
        </div>
    </div>
</div>

<!-- Cards Table -->
<div class="bg-white rounded-3 border shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">Mã Thẻ</th>
                    <th>Sản Phẩm & Hãng</th>
                    <th>Số IMEI / Serial</th>
                    <th>Khách Hàng Sở Hữu</th>
                    <th>Hóa Đơn Mua</th>
                    <th>Thời Hạn Bảo Hành</th>
                    <th>Trạng Thái</th>
                    <th class="text-center" style="width: 120px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-shield-x display-6 d-block mb-2"></i>
                            Không tìm thấy thẻ bảo hành nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var w in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#BH-@w.WarrantyId</td>
                            <td>
                                <div class="fw-bold text-dark">@w.ProductName</div>
                                <span class="badge bg-secondary-subtle text-secondary">@w.BrandName</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(w.ImeiNumber))
                                {
                                    <code class="fw-bold text-primary">@w.ImeiNumber</code>
                                }
                                else if (!string.IsNullOrEmpty(w.SerialNumber))
                                {
                                    <span class="font-monospace text-muted small">@w.SerialNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted small">---</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@w.CustomerName</div>
                                <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@w.CustomerPhone</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">#HD-@w.InvoiceId</span>
                            </td>
                            <td>
                                <div class="small">Từ: <strong>@w.WarrantyStart.ToString("dd/MM/yyyy")</strong></div>
                                <div class="small">Đến: <strong>@w.WarrantyEnd.ToString("dd/MM/yyyy")</strong></div>
                                @if (!w.IsExpired)
                                {
                                    <span class="badge bg-success-subtle text-success mt-1">Còn @w.DaysLeft ngày</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger mt-1">Hết hạn</span>
                                }
                            </td>
                            <td>
                                @if (w.WarrantyStatus == "Active" && !w.IsExpired)
                                {
                                    <span class="badge bg-success">Hiệu lực</span>
                                }
                                else if (w.WarrantyStatus == "Claimed")
                                {
                                    <span class="badge bg-warning text-dark">Đã bảo hành</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Hết hạn</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Create" asp-route-imei="@(w.ImeiNumber ?? w.SerialNumber)" class="btn btn-sm btn-outline-primary" title="Lập phiếu bảo hành">
                                    <i class="bi bi-tools me-1"></i>Bảo hành
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
