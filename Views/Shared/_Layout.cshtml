@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var sessionCart = HttpContextAccessor.HttpContext?.Session.GetString("KittyPhone_Cart");
    int cartCount = 0;
    if (!string.IsNullOrEmpty(sessionCart))
    {
        try
        {
            var items = Newtonsoft.Json.JsonConvert.DeserializeObject<List<BTL_PTTKYC.Models.CartItemModel>>(sessionCart);
            cartCount = items?.Sum(i => i.Quantity) ?? 0;
        }
        catch { }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KittyPhone - Điện thoại, máy tính bảng, phụ kiện chính hãng</title>
    
    <!-- Google Fonts Inter (KittyPhone Typography - Full Range & Vietnamese support) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- KittyPhone Token-driven CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- KittyBot AI Widget CSS -->
    <link rel="stylesheet" href="~/css/kittybot.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Announcement Bar (KittyPhone Campaign Ribbon) -->
    <div class="cps-top-ribbon d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span class="cps-ribbon-badge"><i class="bi bi-gift-fill me-1"></i>Mừng Khai Trương - Deal Thật Hời</span>
                <span>Lên đời tiết kiệm - Trợ giá đến <strong>2.5 triệu</strong></span>
                <span class="d-none d-lg-inline">Sản phẩm <strong>Chính hãng - Xuất VAT đầy đủ</strong></span>
                <span class="d-none d-xl-inline">Giao nhanh - Miễn phí toàn quốc</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="tel:0396166509" class="text-white text-decoration-none">
                    <i class="bi bi-telephone-fill me-1"></i>Hotline: <strong>0396166509</strong>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Header (KittyPhone Ocean Blue Bar) -->
    <header class="cps-main-header">
        <div class="container">
            <div class="cps-header-inner">
                <!-- Brand Logo: KittyPhone Authentic Look -->
                <a asp-controller="Home" asp-action="Index" class="cps-logo text-decoration-none">
                    <span class="cps-logo-text"><i class="bi bi-phone-vibrate text-info me-1"></i>Kitty<span class="cps-logo-s">Phone</span></span>
                </a>

                <!-- Category Button (Dropdown) -->
                <div class="dropdown d-none d-lg-block">
                    <button class="cps-btn-pill dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-grid-fill"></i>
                        <span>Danh mục</span>
                    </button>
                    <ul class="dropdown-menu shadow-lg border-0 rounded-3 py-2 cps-category-dropdown">
                        <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Home" asp-action="Index" asp-route-categoryId="1"><i class="bi bi-phone me-2 text-danger"></i>Điện thoại</a></li>
                        <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Home" asp-action="Index" asp-route-categoryId="2"><i class="bi bi-tablet me-2 text-primary"></i>Máy tính bảng</a></li>
                        <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Home" asp-action="Index" asp-route-categoryId="4"><i class="bi bi-smartwatch me-2 text-warning"></i>Đồng hồ, Smartwatch</a></li>
                        <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Home" asp-action="Index" asp-route-categoryId="3"><i class="bi bi-headphones me-2 text-info"></i>Tai nghe, Loa</a></li>
                        <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Home" asp-action="Index" asp-route-categoryId="3"><i class="bi bi-plug me-2 text-success"></i>Phụ kiện chính hãng</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item py-2 fw-semibold text-danger" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#modalTradeIn"><i class="bi bi-arrow-repeat me-2"></i>Thu cũ đổi mới trợ giá 2.5Tr</a></li>
                    </ul>
                </div>



                <!-- Search Bar -->
                <div class="cps-search-wrap">
                    <form asp-controller="Home" asp-action="Index" method="get" class="cps-search-form">
                        <i class="bi bi-search cps-search-icon"></i>
                        <input type="text" name="keyword" class="cps-search-input" 
                               placeholder="Bạn cần tìm gì hôm nay?" 
                               value="@Context.Request.Query["keyword"]" />
                    </form>
                </div>

                <!-- Header Actions -->
                <div class="cps-header-actions">
                    <!-- Hotline -->
                    <a href="tel:0396166509" class="cps-header-action d-none d-xl-flex text-decoration-none">
                        <i class="bi bi-telephone"></i>
                        <div class="d-flex flex-column text-start">
                            <span class="cps-action-sub">Gọi mua hàng</span>
                            <span class="cps-action-main">0396166509</span>
                        </div>
                    </a>


                    <!-- Tra cứu đơn hàng -->
                    <a asp-controller="Customer" asp-action="Orders" class="cps-header-action d-none d-md-flex text-decoration-none">
                        <i class="bi bi-truck"></i>
                        <div class="d-flex flex-column text-start">
                            <span class="cps-action-sub">Tra cứu</span>
                            <span class="cps-action-main">Đơn hàng</span>
                        </div>
                    </a>

                    <!-- Tra cứu bảo hành -->
                    <a asp-controller="Customer" asp-action="Warranty" class="cps-header-action d-none d-lg-flex text-decoration-none">
                        <i class="bi bi-shield-check"></i>
                        <div class="d-flex flex-column text-start">
                            <span class="cps-action-sub">Tracking</span>
                            <span class="cps-action-main">Bảo hành</span>
                        </div>
                    </a>

                    <!-- Giỏ hàng -->
                    <a asp-controller="Cart" asp-action="Index" class="cps-header-action cps-cart-action text-decoration-none">
                        <div class="position-relative">
                            <i class="bi bi-bag"></i>
                            <span class="cps-cart-badge" id="cartBadgeCount">@cartCount</span>
                        </div>
                        <div class="d-flex flex-column text-start d-none d-sm-flex">
                            <span class="cps-action-sub">Giỏ</span>
                            <span class="cps-action-main">hàng</span>
                        </div>
                    </a>

                    <!-- KittyMember / Đăng nhập tài khoản -->
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Customer"))
                        {
                            <div class="dropdown">
                                <button class="cps-header-action dropdown-toggle border-0" type="button" data-bs-toggle="dropdown">
                                    <div class="cps-user-avatar">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <div class="d-flex flex-column text-start">
                                        <span class="cps-action-sub">KittyMember</span>
                                        <span class="cps-action-main text-truncate" style="max-width: 90px;">@User.Identity.Name</span>
                                    </div>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 py-2">
                                    <li><a class="dropdown-item fw-semibold text-primary" asp-controller="Customer" asp-action="Profile"><i class="bi bi-person-badge me-2"></i>Tài khoản KittyMember</a></li>
                                    <li><a class="dropdown-item fw-semibold" asp-controller="Customer" asp-action="Orders"><i class="bi bi-receipt me-2"></i>Đơn hàng đã đặt</a></li>
                                    <li><a class="dropdown-item fw-semibold text-success" asp-controller="Customer" asp-action="Warranty"><i class="bi bi-shield-check me-2"></i>Tracking bảo hành</a></li>
                                    <li><a class="dropdown-item fw-semibold text-warning" asp-controller="Customer" asp-action="Profile" asp-fragment="homewarranty-pane"><i class="bi bi-house-door me-2"></i>Đăng ký BH tại nhà</a></li>
                                    <li><a class="dropdown-item fw-semibold text-info" asp-controller="Customer" asp-action="ShippingCalculator"><i class="bi bi-calculator me-2"></i>Ước tính phí ship</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Customer" asp-action="Logout" method="post" class="px-2">
                                            <button type="submit" class="btn btn-sm btn-light text-danger w-100 text-start fw-semibold"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="dropdown">
                                <button class="cps-header-action dropdown-toggle border-0" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-lock-fill"></i>
                                    <div class="d-flex flex-column text-start">
                                        <span class="cps-action-sub">Quản trị</span>
                                        <span class="cps-action-main text-truncate" style="max-width: 80px;">@User.Identity.Name</span>
                                    </div>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 py-2">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item fw-bold text-danger" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Accounts"><i class="bi bi-people me-2"></i>Quản lý Tài khoản</a></li>
                                    }
                                    @if (User.IsInRole("Sales") || User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Sales" asp-action="Orders"><i class="bi bi-receipt me-2"></i>Quản lý Đơn hàng</a></li>
                                        <li><a class="dropdown-item" asp-controller="Sales" asp-action="Reviews"><i class="bi bi-chat-heart me-2"></i>Xem Reviews</a></li>
                                        <li><a class="dropdown-item" asp-controller="Sales" asp-action="Products"><i class="bi bi-tag me-2"></i>Nội dung bán hàng</a></li>
                                    }
                                    @if (User.IsInRole("Warehouse") || User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Warehouse" asp-action="Index"><i class="bi bi-box-seam me-2"></i>Quản lý Kho</a></li>
                                    }
                                    @if (User.IsInRole("Technician") || User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item text-primary fw-semibold" asp-controller="Technician" asp-action="Index"><i class="bi bi-tools me-2"></i>Kỹ thuật & Bảo hành</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                            <button type="submit" class="btn btn-sm btn-light text-danger w-100 text-start fw-semibold"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                    }
                    else
                    {
                        <a asp-controller="Customer" asp-action="Login" class="cps-header-action cps-smember-btn text-decoration-none">
                            <i class="bi bi-person-circle"></i>
                            <div class="d-flex flex-column text-start">
                                <span class="cps-action-sub">Thành viên</span>
                                <span class="cps-action-main">Đăng nhập</span>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Body -->
    <main role="main" class="cps-main-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container pt-3">
                <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container pt-3">
                <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <!-- KittyPhone Authentic Light Footer -->
    <footer class="cps-footer">
        <div class="container py-4">
            <div class="row g-4">
                <!-- Col 1: Tổng đài hỗ trợ -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="cps-footer-title">Tổng đài hỗ trợ miễn phí</h6>
                    <ul class="list-unstyled cps-footer-list">
                        <li>Gọi mua hàng: <a href="tel:0396166509" class="fw-bold text-dark">0396166509</a> (7h30 - 22h00)</li>
                        <li>Khiếu nại: <a href="tel:18002063" class="fw-bold text-dark">1800.2063</a> (8h00 - 21h30)</li>
                        <li>Bảo hành: <a href="tel:18002064" class="fw-bold text-dark">1800.2064</a> (8h00 - 21h00)</li>
                    </ul>
                    <h6 class="cps-footer-title mt-4">Phương thức thanh toán</h6>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <span class="cps-pay-badge">VNPAY</span>
                        <span class="cps-pay-badge">MoMo</span>
                        <span class="cps-pay-badge">Visa</span>
                        <span class="cps-pay-badge">MasterCard</span>
                        <span class="cps-pay-badge">Kredivo</span>
                    </div>
                </div>

                <!-- Col 2: Thông tin và chính sách -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="cps-footer-title">Thông tin và chính sách</h6>
                    <ul class="list-unstyled cps-footer-list">
                        <li><a asp-controller="Home" asp-action="Policy" asp-route-tab="online-payment" class="cps-footer-link" onclick="return openPolicyModal('online-payment', event);"><i class="bi bi-chevron-right me-1 small text-danger"></i>Mua hàng và thanh toán Online</a></li>
                        <li><a asp-controller="Home" asp-action="Policy" asp-route-tab="installment-0" class="cps-footer-link" onclick="return openPolicyModal('installment-0', event);"><i class="bi bi-chevron-right me-1 small text-danger"></i>Mua hàng trả góp 0% qua thẻ tín dụng</a></li>
                        <li><a asp-controller="Home" asp-action="Policy" asp-route-tab="shipping-inspection" class="cps-footer-link" onclick="return openPolicyModal('shipping-inspection', event);"><i class="bi bi-chevron-right me-1 small text-danger"></i>Chính sách giao hàng & kiểm hàng</a></li>
                        <li><a asp-controller="Customer" asp-action="ShippingCalculator" class="cps-footer-link"><i class="bi bi-chevron-right me-1 small text-primary"></i>Ước tính phí ship tận nhà & Bảng giá cước</a></li>
                        <li><a asp-controller="Customer" asp-action="Warranty" class="cps-footer-link"><i class="bi bi-chevron-right me-1 small text-success"></i>Tra cứu & Đăng ký bảo hành tại nhà</a></li>
                        <li><a asp-controller="Home" asp-action="Policy" asp-route-tab="warranty-30days" class="cps-footer-link" onclick="return openPolicyModal('warranty-30days', event);"><i class="bi bi-chevron-right me-1 small text-danger"></i>Chính sách bảo hành 1 đổi 1 trong 30 ngày</a></li>
                        <li><a asp-controller="Home" asp-action="Policy" asp-route-tab="vat-invoice" class="cps-footer-link" onclick="return openPolicyModal('vat-invoice', event);"><i class="bi bi-chevron-right me-1 small text-danger"></i>Tra cứu hóa đơn điện tử VAT</a></li>
                        <li><a asp-controller="Home" asp-action="Policy" asp-route-tab="privacy-policy" class="cps-footer-link" onclick="return openPolicyModal('privacy-policy', event);"><i class="bi bi-chevron-right me-1 small text-danger"></i>Chính sách bảo vệ thông tin khách hàng</a></li>
                    </ul>
                </div>

                <!-- Col 3: Dịch vụ và thông tin khác -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="cps-footer-title">Dịch vụ và thông tin khác</h6>
                    <ul class="list-unstyled cps-footer-list">
                        <li><a asp-controller="Home" asp-action="Policy" asp-route-tab="b2b-corporate" class="cps-footer-link" onclick="return openPolicyModal('b2b-corporate', event);"><i class="bi bi-chevron-right me-1 small text-danger"></i>Khách hàng doanh nghiệp (B2B)</a></li>
                        <li><a asp-controller="Home" asp-action="Policy" asp-route-tab="bank-partners" class="cps-footer-link" onclick="return openPolicyModal('bank-partners', event);"><i class="bi bi-chevron-right me-1 small text-danger"></i>Ưu đãi thanh toán ngân hàng & đối tác</a></li>
                        <li><a asp-controller="Home" asp-action="Policy" asp-route-tab="ecommerce-regulation" class="cps-footer-link" onclick="return openPolicyModal('ecommerce-regulation', event);"><i class="bi bi-chevron-right me-1 small text-danger"></i>Quy chế hoạt động sàn TMĐT</a></li>
                        <li><a asp-controller="Home" asp-action="Policy" asp-route-tab="trade-in-subsidy" class="cps-footer-link" onclick="return openPolicyModal('trade-in-subsidy', event);"><i class="bi bi-chevron-right me-1 small text-danger"></i>Thu cũ đổi mới trợ giá đến 2.5 triệu</a></li>
                        <li><a asp-controller="Home" asp-action="Policy" asp-route-tab="recruitment" class="cps-footer-link" onclick="return openPolicyModal('recruitment', event);"><i class="bi bi-chevron-right me-1 small text-danger"></i>Tuyển dụng nhân viên mới nhất</a></li>
                    </ul>
                </div>

                <!-- Col 4: Kết nối & Hệ thống cửa hàng -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="cps-footer-title">Kết nối với KittyPhone</h6>
                    <div class="d-flex gap-3 mb-3 fs-5">
                        <a href="https://youtube.com" class="text-danger"><i class="bi bi-youtube"></i></a>
                        <a href="https://facebook.com" class="text-primary"><i class="bi bi-facebook"></i></a>
                        <a href="https://tiktok.com" class="text-dark"><i class="bi bi-tiktok"></i></a>
                        <a href="https://zalo.me" class="text-info"><i class="bi bi-chat-dots-fill"></i></a>
                    </div>
                    <h6 class="cps-footer-title mt-3">Hệ thống cửa hàng KittyPhone</h6>
                    <p class="small text-muted mb-0" style="line-height: 1.6;">
                        Quận 1, Quận 10, Quận 7, Gò Vấp, TP. Thủ Đức.<br />
                        Mở cửa từ 8h00 - 22h00 các ngày trong tuần.
                    </p>
                </div>
            </div>

            <div class="cps-footer-bottom border-top pt-3 mt-4 text-center small text-muted">
                <p class="mb-1">&copy; 2026 KittyPhone - Hệ thống bán lẻ điện thoại, máy tính bảng, smartwatch và phụ kiện công nghệ chính hãng.</p>
                <p class="mb-0 text-muted" style="font-size: 0.75rem;">Địa chỉ: 249-251 Trần Quang Khải, Phường Tân Định, Quận 1, TP. Hồ Chí Minh - Hotline hỗ trợ: 0396166509</p>
            </div>
        </div>
    </footer>

    <!-- Policy Details Interactive Modal -->
    <div class="modal fade" id="modalPolicyInfo" tabindex="-1" aria-labelledby="modalPolicyInfoLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header text-white border-0 py-3 px-4" style="background: linear-gradient(135deg, #0e2254 0%, #1d4ed8 100%);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check fs-4 text-warning"></i>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 text-white" id="modalPolicyInfoLabel">Trung tâm Thông tin & Chính sách KittyPhone</h5>
                            <span class="small text-white-50">Quy định minh bạch, quyền lợi bảo hành & mua sắm chuẩn chính hãng</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="row g-0">
                        <!-- Left nav pills -->
                        <div class="col-lg-4 col-md-5 bg-light border-end p-3">
                            <div class="nav flex-column nav-pills gap-1" id="modalPolicyTabs" role="tablist">
                                <span class="px-2 pt-1 pb-1 text-muted fw-bold text-uppercase" style="font-size: 11px;">Thông tin & Chính sách</span>
                                <button class="nav-link text-start active py-2 rounded-2 small" id="m-tab-online-payment" data-bs-toggle="pill" data-bs-target="#m-pane-online-payment" type="button" role="tab">
                                    <i class="bi bi-credit-card-2-front me-2 text-primary"></i>Mua hàng & Thanh toán Online
                                </button>
                                <button class="nav-link text-start py-2 rounded-2 small" id="m-tab-installment-0" data-bs-toggle="pill" data-bs-target="#m-pane-installment-0" type="button" role="tab">
                                    <i class="bi bi-percent me-2 text-warning"></i>Trả góp 0% qua thẻ tín dụng
                                </button>
                                <button class="nav-link text-start py-2 rounded-2 small" id="m-tab-shipping-inspection" data-bs-toggle="pill" data-bs-target="#m-pane-shipping-inspection" type="button" role="tab">
                                    <i class="bi bi-truck me-2 text-info"></i>Giao hàng & Kiểm hàng
                                </button>
                                <button class="nav-link text-start py-2 rounded-2 small" id="m-tab-warranty-30days" data-bs-toggle="pill" data-bs-target="#m-pane-warranty-30days" type="button" role="tab">
                                    <i class="bi bi-arrow-repeat me-2 text-success"></i>Bảo hành 1 đổi 1 trong 30 ngày
                                </button>
