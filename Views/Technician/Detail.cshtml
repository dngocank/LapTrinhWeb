@model BTL_PTTKYC.Models.WarrantyTicketModel
@{
    ViewData["Title"] = $"Chi Tiết Phiếu Bảo Hành #{Model.TicketCode}";
    Layout = "_AdminLayout";
}

<!-- Alert Notification -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Top Header Navigation -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Tickets" class="btn btn-sm btn-outline-secondary rounded-pill">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h4 class="fw-bold mb-0">
                Phiếu Bảo Hành: <span class="text-primary font-monospace">@Model.TicketCode</span>
            </h4>
            <span class="badge @Model.StatusBadgeClass fs-6 px-3 py-1">@Model.StatusVietnamese</span>
        </div>
        <span class="text-muted small ms-4 ps-2">Tiếp nhận lúc: @Model.ReceiveDate.ToString("dd/MM/yyyy HH:mm")</span>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="PrintTicket" asp-route-id="@Model.TicketId" target="_blank" class="btn btn-outline-dark rounded-pill px-3">
            <i class="bi bi-printer me-1"></i>In Phiếu Biên Nhận
        </a>

        @if (Model.Status != "Delivered" && Model.Status != "Cancelled")
        {
            <a asp-action="Process" asp-route-id="@Model.TicketId" class="btn btn-warning rounded-pill px-3 fw-bold text-dark">
                <i class="bi bi-wrench me-1"></i>Cập Nhật Kỹ Thuật
            </a>

            @if (Model.Status == "Completed")
            {
                <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#modalDeliver">
                    <i class="bi bi-box-arrow-right me-1"></i>Bàn Giao Trả Máy Khách
                </button>
            }
        }
    </div>
</div>

<!-- Progress Stepper / Pipeline -->
<div class="bg-white p-3 rounded-3 border shadow-sm mb-4">
    <div class="d-flex justify-content-between position-relative px-3 py-2 flex-wrap gap-2">
        <div class="text-center flex-fill">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(Model.Status != "Cancelled" ? "bg-primary text-white" : "bg-light text-muted")" style="width: 38px; height: 38px;">
                <i class="bi bi-inbox-fill"></i>
            </div>
            <div class="small fw-bold mt-1">1. Tiếp nhận máy</div>
            <div class="text-muted" style="font-size: 0.72rem;">@Model.ReceiveDate.ToString("dd/MM/yyyy")</div>
        </div>

        <div class="text-center flex-fill">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(Model.Status == "Diagnosing" || Model.Status == "Processing" || Model.Status == "WaitingParts" || Model.Status == "Completed" || Model.Status == "Delivered" ? "bg-warning text-dark" : "bg-light text-muted")" style="width: 38px; height: 38px;">
                <i class="bi bi-gear-wide-connected"></i>
            </div>
            <div class="small fw-bold mt-1">2. Thẩm định & Sửa chữa</div>
            <div class="text-muted" style="font-size: 0.72rem;">@(string.IsNullOrEmpty(Model.Diagnosis) ? "Chờ xử lý" : "Đã chẩn đoán")</div>
        </div>

        <div class="text-center flex-fill">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(Model.Status == "Completed" || Model.Status == "Delivered" ? "bg-success text-white" : "bg-light text-muted")" style="width: 38px; height: 38px;">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="small fw-bold mt-1">3. Đã sửa xong</div>
            <div class="text-muted" style="font-size: 0.72rem;">@(Model.CompletedDate.HasValue ? Model.CompletedDate.Value.ToString("dd/MM/yyyy") : "Đang xử lý")</div>
        </div>

        <div class="text-center flex-fill">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(Model.Status == "Delivered" ? "bg-dark text-white" : "bg-light text-muted")" style="width: 38px; height: 38px;">
                <i class="bi bi-box-arrow-right"></i>
            </div>
            <div class="small fw-bold mt-1">4. Bàn giao trả khách</div>
            <div class="text-muted" style="font-size: 0.72rem;">@(Model.Status == "Delivered" ? "Đã nhận máy" : "Chờ bàn giao")</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Device & Customer Info -->
    <div class="col-lg-5">
        <!-- Customer Info Card -->
        <div class="bg-white p-4 rounded-3 border shadow-sm mb-4">
            <h6 class="fw-bold mb-3 text-dark border-bottom pb-2">
                <i class="bi bi-person-fill text-primary me-2"></i>Thông Tin Khách Hàng
            </h6>
            <div class="mb-2">
                <span class="text-muted small d-block">Họ và tên khách:</span>
                <span class="fw-bold fs-6 text-dark">@Model.CustomerName</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Số điện thoại liên hệ:</span>
                <a href="tel:@Model.CustomerPhone" class="fw-semibold text-primary text-decoration-none">
                    <i class="bi bi-telephone-fill me-1"></i>@Model.CustomerPhone
                </a>
            </div>
            <div>
                <span class="text-muted small d-block">Kỹ thuật viên phụ trách:</span>
                <span class="badge bg-light text-dark border fs-6">
                    <i class="bi bi-person-badge text-primary me-1"></i>@(Model.TechnicianName ?? "Chưa phân công")
                </span>
            </div>
        </div>

        <!-- Device Info Card -->
        <div class="bg-white p-4 rounded-3 border shadow-sm mb-4">
            <h6 class="fw-bold mb-3 text-dark border-bottom pb-2">
                <i class="bi bi-phone-fill text-primary me-2"></i>Thông Tin Thiết Bị Tiếp Nhận
            </h6>
            <div class="mb-2">
                <span class="text-muted small d-block">Tên dòng máy / Model:</span>
                <span class="fw-bold fs-6 text-dark">@(Model.ProductName ?? "Thiết bị mang ngoài hệ thống")</span>
                @if (!string.IsNullOrEmpty(Model.BrandName))
                {
                    <span class="badge bg-secondary ms-1">@Model.BrandName</span>
                }
            </div>

            <div class="mb-2">
                <span class="text-muted small d-block">Số IMEI:</span>
                <code class="fw-bold fs-6 bg-light p-1 rounded text-primary">@(Model.ImeiNumber ?? "Không có / Không xác định")</code>
            </div>

            @if (!string.IsNullOrEmpty(Model.SerialNumber))
            {
                <div class="mb-2">
                    <span class="text-muted small d-block">Số Serial máy:</span>
                    <span class="font-monospace text-secondary">@Model.SerialNumber</span>
                </div>
            }

            <div class="mb-2">
                <span class="text-muted small d-block">Tình trạng bảo hành gốc của máy:</span>
                <span class="badge @(Model.WarrantyCoverageText == "Còn hạn BH" ? "bg-success" : (Model.WarrantyCoverageText == "Hết hạn BH" ? "bg-danger" : "bg-secondary")) px-2 py-1">
                    @Model.WarrantyCoverageText
                </span>
                @if (Model.WarrantyEnd.HasValue)
                {
                    <span class="small text-muted ms-1">(Hạn: @Model.WarrantyEnd.Value.ToString("dd/MM/yyyy") - Còn @Model.WarrantyDaysRemaining ngày)</span>
                }
            </div>

            <div class="mb-2">
                <span class="text-muted small d-block">Tình trạng ngoại quan khi nhận:</span>
                <div class="p-2 bg-light rounded small border">
                    @(string.IsNullOrEmpty(Model.DeviceCondition) ? "Không có ghi nhận đặc biệt" : Model.DeviceCondition)
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Technical Assessment, Repair Action & Cost -->
    <div class="col-lg-7">
        <!-- Diagnostic & Action Card -->
        <div class="bg-white p-4 rounded-3 border shadow-sm mb-4">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clipboard2-pulse-fill text-danger me-2"></i>Biên Bản Thẩm Định & Xử Lý Kỹ Thuật
                </h6>
                <a asp-action="Process" asp-route-id="@Model.TicketId" class="btn btn-sm btn-outline-warning rounded-pill">
                    <i class="bi bi-pencil me-1"></i>Chỉnh sửa
                </a>
            </div>

            <div class="mb-3">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Hiện tượng lỗi do khách hàng báo:</span>
                <div class="alert alert-light border border-danger border-opacity-25 rounded-3 mb-0">
                    <i class="bi bi-chat-quote-fill text-danger me-2"></i>@Model.CustomerIssue
                </div>
            </div>

            <div class="mb-3">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Chẩn đoán kỹ thuật của Kỹ thuật viên:</span>
                @if (string.IsNullOrEmpty(Model.Diagnosis))
                {
                    <div class="text-muted small fst-italic p-2 bg-light rounded border">
                        Chưa ghi nhận chẩn đoán lỗi. Kỹ thuật viên bấm nút "Cập nhật kỹ thuật" để ghi lại kết quả đo đạc, kiểm tra.
                    </div>
                }
                else
                {
                    <div class="p-3 bg-light rounded-3 border">
                        <i class="bi bi-check2-circle text-primary me-2"></i>@Model.Diagnosis
                    </div>
                }
            </div>

            <div class="mb-3">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Phương án khắc phục / Sửa chữa:</span>
                @if (string.IsNullOrEmpty(Model.RepairAction))
                {
                    <div class="text-muted small fst-italic p-2 bg-light rounded border">
                        Chưa có phương án xử lý cụ thể.
                    </div>
                }
                else
                {
                    <div class="p-3 bg-light rounded-3 border">
                        <i class="bi bi-tools text-warning me-2"></i>@Model.RepairAction
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="mb-3">
                    <span class="text-muted small fw-bold text-uppercase d-block mb-1">Ghi chú thêm:</span>
                    <div class="small text-muted p-2 bg-light rounded border">@Model.Notes</div>
                </div>
            }
        </div>

        <!-- Components and Cost Breakdown -->
        <div class="bg-white p-4 rounded-3 border shadow-sm">
            <h6 class="fw-bold mb-3 text-dark border-bottom pb-2">
                <i class="bi bi-cpu-fill text-primary me-2"></i>Linh Kiện Thay Thế & Chi Phí Sửa Chữa
            </h6>

            @if (Model.Components.Count == 0)
            {
                <div class="text-muted small mb-3">
                    Không sử dụng thêm linh kiện tính phí ngoài.
                </div>
            }
            else
            {
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Tên Linh Kiện / Dịch Vụ</th>
                                <th class="text-center" style="width: 70px;">SL</th>
                                <th class="text-end" style="width: 120px;">Đơn Giá</th>
                                <th class="text-end" style="width: 130px;">Thành Tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var comp in Model.Components)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@comp.ComponentName</div>
                                        @if (!string.IsNullOrEmpty(comp.Note))
                                        {
                                            <div class="small text-muted">@comp.Note</div>
                                        }
                                    </td>
                                    <td class="text-center">@comp.Quantity</td>
                                    <td class="text-end">@comp.Price.ToString("N0")đ</td>
                                    <td class="text-end fw-bold">@comp.LineTotal.ToString("N0")đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 border">
                <div>
                    <span class="fw-bold text-dark fs-6">TỔNG CHI PHÍ THANH TOÁN:</span>
                    <div class="small text-muted">
                        @(Model.RepairCost == 0 ? "(Miễn phí 100% trong chính sách bảo hành chính hãng)" : "(Chi phí sửa chữa dịch vụ / linh kiện ngoài hạn)")
                    </div>
                </div>
                <div class="fs-4 fw-bold @(Model.RepairCost == 0 ? "text-success" : "text-danger")">
                    @Model.RepairCost.ToString("N0") VNĐ
                </div>
            </div>
        </div>

        <!-- Section: Thanh Toán Chi Phí Sửa Chữa & Quét Mã QR ZaloPay / Tiền Mặt -->
        <div class="bg-white p-4 rounded-3 border shadow-sm mt-4">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 flex-wrap gap-2">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-credit-card-2-front-fill text-primary me-2"></i>Thanh Toán Dịch Vụ & Chi Phí Sửa Chữa
                </h6>
                <div>
                    @if (Model.RepairCost == 0)
                    {
                        <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-shield-check me-1"></i>Miễn Phí 100% (Bảo Hành)</span>
                    }
                    else if (Model.PaymentStatus == "Paid")
                    {
                        <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-check-circle-fill me-1"></i>Đã Thanh Toán Thành Công</span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-2 fs-6"><i class="bi bi-clock-history me-1"></i>Chưa Thanh Toán</span>
                    }
                </div>
            </div>

            @if (Model.RepairCost == 0)
            {
                <div class="alert alert-success d-flex align-items-center mb-0">
                    <i class="bi bi-patch-check-fill fs-3 me-3 text-success"></i>
                    <div>
                        <strong>Bảo hành chính hãng không phát sinh chi phí:</strong> Toàn bộ chi phí sửa chữa, linh kiện và công kiểm tra kỹ thuật đều được miễn phí 100% theo chế độ bảo hành của hệ thống KittyPhone.
                    </div>
                </div>
            }
            else if (Model.PaymentStatus == "Paid")
            {
                <!-- Paid Receipt Box -->
                <div class="p-3 rounded-3 border" style="background: #f0fdf4; border-color: #86efac !important;">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-success fs-6"><i class="bi bi-check2-all me-1"></i>ĐÃ THU TIỀN HOÀN TẤT</span>
                                <span class="text-muted small">Thời gian: @(Model.PaidAt?.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</span>
                            </div>
                            <div class="mb-1">
                                <span class="text-muted small">Phương thức thanh toán:</span>
                                <strong class="text-dark">@(Model.PaymentMethod ?? "Quét mã QR ZaloPay")</strong>
                            </div>
                            @if (Model.DiscountAmount > 0)
                            {
                                <div class="mb-1 text-danger small">
                                    <span>Giảm trừ Voucher (@(string.IsNullOrEmpty(Model.VoucherCode) ? "Mã giảm giá" : Model.VoucherCode)):</span>
                                    <strong>-@Model.DiscountAmount.ToString("N0")đ</strong>
                                </div>
                            }
                            <div>
                                <span class="text-muted small">Số tiền thực tế đã thu:</span>
                                <span class="fs-4 fw-bold text-success">@Model.PaidAmount.ToString("N0") VNĐ</span>
                            </div>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <a asp-action="PrintTicket" asp-route-id="@Model.TicketId" target="_blank" class="btn btn-outline-success rounded-pill px-3">
                                <i class="bi bi-printer me-1"></i>In Phiếu Thu Tiền
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Unpaid: Payment Form with Live ZaloPay QR and Voucher -->
                <div class="row g-4">
                    <!-- Left: Payment Options & Voucher Input -->
                    <div class="col-lg-6">
                        <div class="p-3 rounded-3 bg-light border mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Chi phí sửa chữa gốc:</span>
                                <strong class="text-dark fs-6" id="txtOrigCost">@Model.RepairCost.ToString("N0")đ</strong>
                            </div>
                            
                            <!-- Voucher discount input -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark mb-1">Mã Voucher / Giảm giá (nếu có):</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" id="inputWarrantyVoucher" class="form-control text-uppercase" placeholder="VD: KITTYBH10, TRIANKHACH..." />
                                    <button type="button" class="btn btn-outline-primary" id="btnApplyWarrantyVoucher">Áp dụng</button>
                                </div>
                                <div class="small mt-1 text-muted">
                                    <i class="bi bi-info-circle me-1"></i>Gợi ý: <span class="badge bg-light text-primary border cursor-pointer" onclick="$('#inputWarrantyVoucher').val('KITTYBH10');$('#btnApplyWarrantyVoucher').click();">KITTYBH10 (-10%)</span> <span class="badge bg-light text-primary border cursor-pointer" onclick="$('#inputWarrantyVoucher').val('TRIANKHACH');$('#btnApplyWarrantyVoucher').click();">TRIANKHACH (-50k)</span>
                                </div>
                                <div id="warrantyVoucherAlert" class="small mt-1 text-success fw-semibold" style="display: none;"></div>
                            </div>

                            <div class="d-flex justify-content-between mb-2 text-danger small" id="rowWarrantyDiscount" style="display: none;">
                                <span><i class="bi bi-gift-fill me-1"></i>Chiết khấu khuyến mãi:</span>
                                <strong id="txtWarrantyDiscountAmount">-0đ</strong>
                            </div>

                            <div class="d-flex justify-content-between align-items-baseline border-top pt-2">
                                <span class="fw-bold text-dark fs-6">SỐ TIỀN CẦN THANH TOÁN:</span>
                                <span class="fs-4 fw-bold text-primary" id="txtWarrantyFinalAmount">@Model.RepairCost.ToString("N0")đ</span>
                            </div>
                        </div>

                        <!-- Choose payment method -->
                        <form asp-action="ProcessPayment" method="post" id="formWarrantyPayment">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ticketId" value="@Model.TicketId" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Detail", new { id = Model.TicketId })" />
                            <input type="hidden" name="paidAmount" id="hdnPaidAmount" value="@Model.RepairCost" />
                            <input type="hidden" name="discountAmount" id="hdnDiscountAmount" value="0" />
                            <input type="hidden" name="voucherCode" id="hdnVoucherCode" value="" />
                            <input type="hidden" name="paymentMethod" id="hdnPaymentMethod" value="ZaloPay QR" />

                            <label class="form-label small fw-bold text-dark mb-2">Chọn phương thức thanh toán:</label>
                            <div class="d-flex flex-column gap-2 mb-3">
                                <div class="form-check p-2 border rounded-3 bg-white d-flex align-items-center gap-2">
                                    <input class="form-check-input ms-1" type="radio" name="radPaymentMethod" id="radZaloPay" value="ZaloPay QR" checked onchange="switchWarrantyMethod('ZaloPay QR')">
                                    <label class="form-check-label fw-bold text-dark cursor-pointer flex-fill" for="radZaloPay">
                                        <i class="bi bi-qr-code-scan text-primary me-1"></i>Quét mã QR ZaloPay / VietQR (Khuyên dùng)
                                    </label>
                                </div>
                                <div class="form-check p-2 border rounded-3 bg-white d-flex align-items-center gap-2">
                                    <input class="form-check-input ms-1" type="radio" name="radPaymentMethod" id="radCash" value="Tiền mặt" onchange="switchWarrantyMethod('Tiền mặt')">
                                    <label class="form-check-label fw-bold text-dark cursor-pointer flex-fill" for="radCash">
                                        <i class="bi bi-cash-stack text-success me-1"></i>Thu tiền mặt trực tiếp tại quầy
                                    </label>
                                </div>
                                <div class="form-check p-2 border rounded-3 bg-white d-flex align-items-center gap-2">
                                    <input class="form-check-input ms-1" type="radio" name="radPaymentMethod" id="radPOS" value="Thẻ POS" onchange="switchWarrantyMethod('Thẻ POS')">
                                    <label class="form-check-label fw-bold text-dark cursor-pointer flex-fill" for="radPOS">
                                        <i class="bi bi-credit-card text-info me-1"></i>Quẹt thẻ qua máy POS ngân hàng
                                    </label>
                                </div>
                            </div>

                            <!-- Custom amount input -->
                            <div class="mb-3">
                                <label class="form-label small text-muted mb-1">Số tiền xác nhận thu thực tế (VNĐ):</label>
                                <input type="number" id="inputCustomAmount" class="form-control" value="@Model.RepairCost" min="0" step="1000" oninput="onCustomAmountChange()" />
                            </div>

                            <button type="submit" class="btn btn-primary rounded-pill w-100 py-2 fw-bold" id="btnSubmitPayment">
                                <i class="bi bi-check-circle-fill me-1"></i>Xác Nhận Đã Nhận Thanh Toán
                            </button>
                        </form>
                    </div>

                    <!-- Right: Dynamic VietQR Display Box -->
                    <div class="col-lg-6">
                        <div id="warrantyQrBox" class="p-3 rounded-3 border text-center h-100 d-flex flex-column justify-content-center align-items-center" style="background: #fafafa;">
                            <div class="small fw-bold text-dark mb-2">
                                <i class="bi bi-qr-code me-1 text-primary"></i>MÃ QR CHUYỂN KHOẢN TỰ ĐỘNG (ZALOPAY / VIETQR)
                            </div>
                            
                            <div class="bg-white p-2 rounded-3 shadow-sm border d-inline-block mb-2">
                                <img id="imgWarrantyQr" 
                                     src="https://img.vietqr.io/image/970454-0396166509-compact2.png?amount=@((long)Model.RepairCost)&addInfo=@(Uri.EscapeDataString($"BH {Model.TicketCode}"))&accountName=DUONG%20NGOC%20ANH" 
                                     alt="QR Thanh toán ZaloPay" 
                                     class="img-fluid rounded" 
                                     style="max-width: 200px; height: auto;" />
                            </div>

                            <div class="small text-muted mb-2">
                                Quét bằng <strong class="text-primary">ZaloPay</strong> hoặc bất kỳ App Ngân Hàng nào
                            </div>

                            <div class="w-100 text-start bg-white p-2 rounded border small">
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Ngân hàng thụ hưởng:</span>
                                    <strong class="text-dark">ZaloPay / VietQR</strong>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Số tài khoản ZaloPay:</span>
                                    <span class="fw-bold font-monospace text-primary">0396166509</span>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Chủ tài khoản:</span>
                                    <strong class="text-dark">DUONG NGOC ANH</strong>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Số tiền thanh toán:</span>
                                    <strong class="text-primary" id="txtQrDisplayAmount">@Model.RepairCost.ToString("N0")đ</strong>
                                </div>
                                <div class="d-flex justify-content-between py-1">
                                    <span class="text-muted">Nội dung chuyển:</span>
                                    <span class="badge bg-primary font-monospace">BH @Model.TicketCode</span>
                                </div>
                            </div>
                        </div>

                        <div id="warrantyCashNotice" class="p-4 rounded-3 border text-center h-100 d-flex flex-column justify-content-center align-items-center" style="display: none; background: #f0fdf4;">
                            <i class="bi bi-cash-stack text-success display-4 mb-2"></i>
                            <h6 class="fw-bold text-dark">Thu Tiền Mặt Trực Tiếp Tại Quầy</h6>
                            <p class="text-muted small mb-0">Kỹ thuật viên kiểm đếm tiền mặt đúng số tiền từ khách hàng, sau đó bấm nút "Xác Nhận Đã Nhận Thanh Toán" để cập nhật hệ thống.</p>
                        </div>

                        <div id="warrantyPosNotice" class="p-4 rounded-3 border text-center h-100 d-flex flex-column justify-content-center align-items-center" style="display: none; background: #f0f9ff;">
                            <i class="bi bi-credit-card-2-front text-info display-4 mb-2"></i>
                            <h6 class="fw-bold text-dark">Quẹt Thẻ Qua Máy POS</h6>
                            <p class="text-muted small mb-0">Cắm hoặc chạm thẻ ATM/Visa/Master của khách vào máy POS tại cửa hàng, in hóa đơn POS và bấm "Xác Nhận Đã Nhận Thanh Toán".</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Bàn Giao Trả Máy -->
<div class="modal fade" id="modalDeliver" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Deliver" asp-route-id="@Model.TicketId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Url.Action("Detail", new { id = Model.TicketId })" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-success">
                        <i class="bi bi-box-arrow-right me-2"></i>Bàn Giao Trả Máy Cho Khách Hàng
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border mb-3">
                        <div>Mã phiếu: <strong class="text-primary font-monospace">@Model.TicketCode</strong></div>
                        <div>Khách hàng: <strong>@Model.CustomerName</strong> (@Model.CustomerPhone)</div>
                        <div>Tổng chi phí cần thu: <strong class="text-danger fs-6">@Model.RepairCost.ToString("N0")đ</strong></div>
                        <div>Trạng thái thanh toán: 
                            @if (Model.RepairCost == 0 || Model.PaymentStatus == "Paid")
                            {
                                <span class="badge bg-success ms-1"><i class="bi bi-check2 me-1"></i>Đã thanh toán đủ</span>
                            }
                            else
                            {
                                <span class="badge bg-danger ms-1"><i class="bi bi-clock me-1"></i>Chưa thanh toán</span>
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi chú khi bàn giao máy cho khách:</label>
                        <textarea name="notes" class="form-control" rows="3" placeholder="Ví dụ: Khách đã kiểm tra test kỹ máy tại quầy, chức năng hoạt động bình thường, đã thanh toán đủ tiền..."></textarea>
                    </div>
                    <div class="form-text small text-danger">
                        <i class="bi bi-exclamation-circle me-1"></i>Hành động này sẽ cập nhật trạng thái phiếu thành <strong>Đã trả khách (Delivered)</strong> và chốt thời gian hoàn tất.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Xác Nhận Bàn Giao Máy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let origRepairCost = @Model.RepairCost;
    let currentRepairAmount = origRepairCost;
    let currentDiscount = 0;
    let ticketCode = '@Model.TicketCode';

    function formatVND(n) {
        return Math.round(n).toLocaleString('vi-VN') + 'đ';
    }

    function updateWarrantyQr(amount) {
        const safeAmount = Math.max(0, Math.round(amount));
        const syntax = 'BH ' + ticketCode;
        const qrUrl = 'https://img.vietqr.io/image/970454-0396166509-compact2.png?amount=' + safeAmount + '&addInfo=' + encodeURIComponent(syntax) + '&accountName=DUONG%20NGOC%20ANH';
        $('#imgWarrantyQr').attr('src', qrUrl);
        $('#txtQrDisplayAmount').text(formatVND(safeAmount));
        $('#txtWarrantyFinalAmount').text(formatVND(safeAmount));
        $('#hdnPaidAmount').val(safeAmount);
    }

    function onCustomAmountChange() {
        const val = parseFloat($('#inputCustomAmount').val()) || 0;
        updateWarrantyQr(val);
    }

    function switchWarrantyMethod(method) {
        $('#hdnPaymentMethod').val(method);
        if (method === 'ZaloPay QR') {
            $('#warrantyQrBox').show();
            $('#warrantyCashNotice').hide();
            $('#warrantyPosNotice').hide();
        } else if (method === 'Tiền mặt') {
            $('#warrantyQrBox').hide();
            $('#warrantyCashNotice').show();
            $('#warrantyPosNotice').hide();
        } else if (method === 'Thẻ POS') {
            $('#warrantyQrBox').hide();
            $('#warrantyCashNotice').hide();
            $('#warrantyPosNotice').show();
        }
    }

    $('#btnApplyWarrantyVoucher').click(function() {
        const code = ($('#inputWarrantyVoucher').val() || '').trim().toUpperCase();
        if (!code) return;

        if (code === 'KITTYBH10') {
            currentDiscount = Math.round(origRepairCost * 0.1);
            $('#hdnVoucherCode').val('KITTYBH10');
            $('#warrantyVoucherAlert').text('Áp dụng mã KITTYBH10 thành công: Giảm 10% (-' + formatVND(currentDiscount) + ')').show();
        } else if (code === 'TRIANKHACH') {
            currentDiscount = Math.min(50000, origRepairCost);
            $('#hdnVoucherCode').val('TRIANKHACH');
            $('#warrantyVoucherAlert').text('Áp dụng mã TRIANKHACH thành công: Giảm 50.000đ (-' + formatVND(currentDiscount) + ')').show();
        } else {
            currentDiscount = Math.round(origRepairCost * 0.05);
            $('#hdnVoucherCode').val(code);
            $('#warrantyVoucherAlert').text('Áp dụng mã ' + code + ' thành công: Giảm 5% (-' + formatVND(currentDiscount) + ')').show();
        }

        currentRepairAmount = Math.max(0, origRepairCost - currentDiscount);
        $('#hdnDiscountAmount').val(currentDiscount);
        $('#txtWarrantyDiscountAmount').text('-' + formatVND(currentDiscount));
        $('#rowWarrantyDiscount').show();
        $('#inputCustomAmount').val(currentRepairAmount);
        updateWarrantyQr(currentRepairAmount);
    });
</script>
}
