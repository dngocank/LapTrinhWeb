@model BTL_PTTKYC.Models.ProductViewModel
@{
    ViewData["Title"] = $"Chỉnh Sửa Sản Phẩm: {Model.ProductName}";
    Layout = "_AdminLayout";
    var brands = ViewBag.Brands as List<(int id, string name)> ?? new();
    var categories = ViewBag.Categories as List<(int id, string name)> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Products" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>
            <h4 class="fw-bold mb-0 text-dark">Chỉnh Sửa Thông Tin Sản Phẩm</h4>
        </div>

        <div class="bg-white p-4 rounded-3 border shadow-sm">
            <form asp-action="EditProduct" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProductId" />
                <input type="hidden" asp-for="ImportPrice" />
                <input type="hidden" asp-for="Quantity" />

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label fw-semibold">Tên sản phẩm <span class="text-danger">*</span></label>
                    <input asp-for="ProductName" class="form-control" required />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="BrandId" class="form-label fw-semibold">Hãng sản xuất</label>
                        <select asp-for="BrandId" class="form-select">
                            @foreach (var b in brands)
                            {
                                <option value="@b.id" selected="@(Model.BrandId == b.id)">@b.name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Danh mục</label>
                        <select asp-for="CategoryId" class="form-select">
                            @foreach (var c in categories)
                            {
                                <option value="@c.id" selected="@(Model.CategoryId == c.id)">@c.name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="SellingPrice" class="form-label fw-semibold">Giá bán niêm yết (VNĐ) <span class="text-danger">*</span></label>
                        <input asp-for="SellingPrice" type="number" step="10000" class="form-control" required />
                        <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Số lượng tồn kho</label>
                        <input type="text" class="form-control bg-light" value="@Model.Quantity chiếc (Thay đổi qua phiếu nhập kho)" readonly />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label fw-semibold">URL Hình ảnh</label>
                    <input asp-for="ImageUrl" class="form-control" />
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mt-2 text-center p-2 rounded border" style="background: rgba(255,255,255,0.02);">
                            <img src="@Model.ImageUrl" 
                                 style="max-height: 120px; object-fit: contain;" 
                                 class="rounded bg-white p-1" 
                                 onerror="this.onerror=null;this.src='/images/placeholder-phone.svg';" />
                        </div>
                    }
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold">Mô tả sản phẩm</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeProduct">
                    <label class="form-check-label fw-semibold" for="activeProduct">Đang mở bán trên storefront KittyPhone</label>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Products" class="btn btn-secondary rounded-pill px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-check2-circle me-1"></i>Lưu Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
