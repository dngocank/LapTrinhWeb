@model List<BTL_PTTKYC.Models.ReviewModel>
@{
    ViewData["Title"] = "Quản Lý Đánh Giá & Nhận Xét";
    Layout = "_AdminLayout";
    var products = ViewBag.Products as List<BTL_PTTKYC.Models.ProductViewModel> ?? new();
    int? selectedProductId = ViewBag.SelectedProductId as int?;
    int? selectedRating = ViewBag.SelectedRating as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-chat-heart text-primary me-2"></i>Đánh Giá & Nhận Xét Của Khách Hàng</h4>
        <span class="text-muted small">Khách hàng viết đánh giá chân thực - Nhân viên có thể theo dõi và phản hồi khách hàng</span>
    </div>
</div>

<!-- Filters -->
<div class="bg-white p-3 rounded-3 border mb-4 shadow-sm">
    <form asp-action="Reviews" method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <select name="productId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- Tất cả sản phẩm --</option>
                @foreach (var p in products)
                {
                    <option value="@p.ProductId" selected="@(selectedProductId == p.ProductId)">@p.ProductName</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="rating" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- Tất cả số sao --</option>
                <option value="5" selected="@(selectedRating == 5)">5 Sao (Xuất sắc)</option>
                <option value="4" selected="@(selectedRating == 4)">4 Sao (Hài lòng)</option>
                <option value="3" selected="@(selectedRating == 3)">3 Sao (Bình thường)</option>
                <option value="2" selected="@(selectedRating == 2)">2 Sao (Chưa hài lòng)</option>
                <option value="1" selected="@(selectedRating == 1)">1 Sao (Kém)</option>
            </select>
        </div>
        <div class="col-md-4 text-end">
            <span class="badge bg-primary rounded-pill px-3 py-2">Tổng cộng: @Model.Count đánh giá</span>
        </div>
    </form>
</div>

<!-- Reviews Table -->
<div class="bg-white rounded-3 border shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 150px;">Khách Hàng</th>
                    <th style="width: 180px;">Sản Phẩm</th>
                    <th style="width: 120px;">Số Sao</th>
                    <th>Nội Dung Nhận Xét</th>
                    <th>Phản Hồi Từ Cửa Hàng</th>
                    <th class="text-center" style="width: 120px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-chat-left-dots display-6 d-block mb-2"></i>
                            Chưa có đánh giá nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var rev in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-dark">@rev.CustomerName</strong>
                                @if (rev.IsVerifiedPurchase)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill ms-1" style="font-size: 0.68rem;">
                                        <i class="bi bi-shield-check"></i> Đã mua hàng
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(rev.Phone))
                                {
                                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@rev.Phone</div>
                                }
                                <div class="text-muted" style="font-size: 0.72rem;">@rev.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>
                                <span class="fw-semibold text-primary">@rev.ProductName</span>
                            </td>
                            <td>
                                <div class="text-warning small">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        if (s <= rev.Rating) { <i class="bi bi-star-fill"></i> }
                                        else { <i class="bi bi-star"></i> }
                                    }
                                    <span class="text-dark fw-bold ms-1">@rev.Rating sao</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-dark small">@rev.Comment</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(rev.Reply))
                                {
                                    <div class="p-2 rounded border-start border-primary border-3 small bg-light">
                                        <strong class="text-primary d-block" style="font-size: 0.75rem;">Phản hồi:</strong>
                                        <span class="text-dark">@rev.Reply</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Chưa phản hồi</span>
                                }
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#replyModal_@rev.ReviewId">
                                    <i class="bi bi-reply-fill me-1"></i>Trả lời
                                </button>

                                <!-- Reply Modal -->
                                <div class="modal fade text-start" id="replyModal_@rev.ReviewId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form asp-action="ReplyReview" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reviewId" value="@rev.ReviewId" />
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold text-white">Phản Hồi Đánh Giá Của @rev.CustomerName</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="p-3 bg-light rounded mb-3">
                                                        <span class="text-muted small d-block">Khách hàng nhận xét:</span>
                                                        <strong class="text-white">"@rev.Comment"</strong>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Nội dung phản hồi từ KittyPhone</label>
                                                        <textarea name="reply" class="form-control" rows="3" placeholder="Nhập câu trả lời hoặc cảm ơn khách hàng từ KittyPhone..." required>@rev.Reply</textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Đóng</button>
                                                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Lưu Phản Hồi</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
