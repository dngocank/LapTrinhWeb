PORT=3001

# Cấu hình kết nối SQL Server PhoneStoreDB
# Nếu dùng Windows Authentication (khớp với appsettings.json): giữ nguyên DB_SERVER
# Nếu dùng SQL Authentication: điền thêm DB_USER và DB_PASSWORD
DB_SERVER=localhost\\SQLEXPRESS
DB_PORT=1433
DB_NAME=PhoneStoreDB
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Khóa API Groq Cloud (Đăng ký miễn phí tại https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
