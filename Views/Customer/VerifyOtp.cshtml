@model BTL_PTTKYC.Models.CustomerVerifyOtpViewModel
@{
    ViewData["Title"] = "Xác Thực OTP Tài Khoản | KittyPhone";
}

<div class="auth-wrapper py-5">
    <div class="container d-flex justify-content-center">
        <div class="auth-card">
            <!-- Header -->
            <div class="auth-card-header">
                <div class="d-inline-flex p-3 rounded-circle bg-white text-primary mb-3 shadow-sm" style="width: 58px; height: 58px; align-items: center; justify-content: center;">
                    <i class="bi bi-shield-lock-fill fs-2 text-primary"></i>
                </div>
                <h4 class="fw-bold mb-1 text-white">Xác Thực SĐT & Email</h4>
                <p class="small text-white-50 mb-0">Xác minh bảo mật & kích hoạt tài khoản KittyMember</p>
            </div>

            <!-- Body -->
            <div class="auth-card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["WarningMessage"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>@TempData["WarningMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger d-inline mb-0" })
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.SimulatedOtp))
                {
                    <div class="p-3 mb-4 rounded-3 border border-success bg-success-subtle text-success-emphasis">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="fw-bold small"><i class="bi bi-phone me-1"></i>Mã OTP Giả Lập Hệ Thống:</span>
                            <span class="badge bg-success rounded-pill px-2 py-1">Khả Dụng</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="fs-4 fw-bold font-monospace tracking-widest text-dark bg-white px-3 py-1 rounded border">
                                @Model.SimulatedOtp
                            </span>
                            <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3" onclick="document.getElementById('otpInput').value = '@Model.SimulatedOtp';">
                                <i class="bi bi-clipboard-check me-1"></i>Tự động điền
                            </button>
                        </div>
                        <span class="d-block mt-2 small text-muted" style="font-size: 0.78rem;">
                            (Đã gửi đồng thời đến SĐT <strong>@Model.PhoneOrEmail</strong> và Email. Hiệu lực 15 phút)
                        </span>
                    </div>
                }

                <form asp-action="VerifyOtp" method="post">
                    <input type="hidden" asp-for="PhoneOrEmail" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3 text-center">
                        <label class="form-label fw-bold text-dark small mb-2 text-uppercase">NHẬP MÃ OTP 6 CHỮ SỐ</label>
                        <input asp-for="OtpCode" id="otpInput" class="form-control text-center fs-2 font-monospace fw-bold tracking-widest" 
                               maxlength="6" placeholder="------" autofocus autocomplete="one-time-code" style="letter-spacing: 0.4em;" />
                        <span asp-validation-for="OtpCode" class="text-danger small d-block mt-1"></span>
                    </div>

                    <button type="submit" class="btn text-white w-100 py-2 rounded-pill fw-bold shadow-sm mb-3" style="background: linear-gradient(135deg, #0e2254, #0284c7); border: none;">
                        <i class="bi bi-check2-circle me-1"></i>XÁC NHẬN & HOÀN TẤT
                    </button>
                </form>

                <div class="d-flex align-items-center justify-content-between pt-3 border-top flex-wrap gap-2">
                    <form asp-action="ResendOtp" method="post" class="d-inline">
                        <input type="hidden" name="target" value="@Model.PhoneOrEmail" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-link btn-sm text-decoration-none p-0 text-muted">
                            <i class="bi bi-arrow-clockwise me-1"></i>Gửi lại mã OTP
                        </button>
                    </form>

                    <a asp-controller="Customer" asp-action="Login" class="text-primary small fw-semibold text-decoration-none">
                        Về trang Đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
