@model BTL_PTTKYC.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thông tin đặt hàng & thanh toán | KittyPhone";
}

<div class="container py-4">
    <!-- Step Indicator -->
    <div class="cps-checkout-container mb-4">
        <div class="cps-checkout-steps">
            <div class="cps-step-item">
                <span class="cps-step-num"><i class="bi bi-check"></i></span>
                <span>Chọn sản phẩm</span>
            </div>
            <div class="cps-step-divider"></div>
            <div class="cps-step-item active">
                <span class="cps-step-num">2</span>
                <span>Thông tin đặt hàng</span>
            </div>
            <div class="cps-step-divider"></div>
            <div class="cps-step-item">
                <span class="cps-step-num">3</span>
                <span>Hoàn tất đặt hàng</span>
            </div>
        </div>
    </div>

    <div class="cps-checkout-container">
        <!-- Authenticated Member Banner -->
        <div class="alert alert-primary border-0 d-flex align-items-center justify-content-between mb-4 rounded-3 shadow-sm py-3" style="background-color: #f0f9ff; border-left: 4px solid var(--brand-blue) !important;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #0e2254, #0284c7);">
                    <i class="bi bi-person-check-fill fs-5"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <strong class="text-dark">Tài khoản đặt hàng: <span class="text-primary">@User.Identity?.Name</span></strong>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 11px;"><i class="bi bi-patch-check-fill me-1"></i>KittyMember</span>
                    </div>
                    <span class="text-muted d-block small">Đơn hàng sẽ được tự động liên kết vào lịch sử mua sắm để tích điểm và kích hoạt bảo hành điện tử chính hãng.</span>
                </div>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger shadow-sm mb-4">
                <div asp-validation-summary="All" class="text-danger mb-0 small"></div>
            </div>
        }

        <form asp-action="Checkout" method="post" id="checkoutForm">
            @if (Model.SingleProductId.HasValue)
            {
                <input type="hidden" asp-for="SingleProductId" />
                <input type="hidden" asp-for="SingleQuantity" />
            }

            <!-- Hidden Inputs for Delivery & Shipping Carrier -->
            <input type="hidden" asp-for="DeliveryMethod" id="hdnDeliveryMethod" value="HomeDelivery" />
            <input type="hidden" asp-for="ShippingCarrier" id="hdnShippingCarrier" value="@(string.IsNullOrEmpty(Model.ShippingCarrier) ? "xanhsm" : Model.ShippingCarrier)" />
            <input type="hidden" asp-for="ShippingCarrierName" id="hdnShippingCarrierName" value="@(string.IsNullOrEmpty(Model.ShippingCarrierName) ? "Xanh SM Express" : Model.ShippingCarrierName)" />
            <input type="hidden" asp-for="ShippingFee" id="hdnShippingFee" value="@Model.ShippingFee" />
            <input type="hidden" asp-for="ShippingDistanceKm" id="hdnShippingDistanceKm" value="@Model.ShippingDistanceKm" />
            <input type="hidden" asp-for="ShippingServiceType" id="hdnShippingServiceType" value="@Model.ShippingServiceType" />

            <div class="row g-4">
                <!-- Left: Customer Information & Delivery & Payment -->
                <div class="col-lg-7">
                    <!-- Delivery / Recipient Details Card -->
                    <div class="bg-white p-4 rounded-3 border shadow-sm mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                            <h6 class="fw-bold mb-0 text-dark">
                                <i class="bi bi-person-lines-fill text-primary me-2"></i>1. THÔNG TIN KHÁCH HÀNG & NHẬN HÀNG
                            </h6>
                            <span class="badge bg-primary-subtle text-primary" style="font-size: 11px;">Ship tận nhà & Nhận tại shop</span>
                        </div>

                        <!-- Delivery Method Switcher -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-dark mb-2">Hình thức nhận hàng:</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="delivery-method-card active p-2 border rounded-3 text-center cursor-pointer" id="btnMethodHome" onclick="selectDeliveryMethod('HomeDelivery')">
                                        <i class="bi bi-truck fs-5 text-primary d-block mb-1"></i>
                                        <strong class="small d-block text-dark">Giao hàng tận nhà</strong>
                                        <span class="text-muted" style="font-size: 11px;">Hỏa tốc xe máy / Bưu tá</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="delivery-method-card p-2 border rounded-3 text-center cursor-pointer" id="btnMethodStore" onclick="selectDeliveryMethod('StorePickup')">
                                        <i class="bi bi-shop fs-5 text-secondary d-block mb-1"></i>
                                        <strong class="small d-block text-dark">Lấy tại cửa hàng</strong>
                                        <span class="text-muted" style="font-size: 11px;">123 Thái Hà, Đống Đa (Miễn phí)</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CustomerName" class="form-label fw-bold small text-dark">Họ và tên người nhận <span class="text-danger">*</span></label>
                                <input asp-for="CustomerName" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" required />
                                <span asp-validation-for="CustomerName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-bold small text-dark">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                                <input asp-for="Phone" class="form-control" placeholder="Ví dụ: 0912345678" required />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <!-- Store Pickup Details (Hiển thị khi chọn Lấy tại cửa hàng) -->
                            <div class="col-12" id="boxStorePickupDetails" style="display: none;">
                                <div class="p-3 rounded-3 border bg-light text-dark">
                                    <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold">
                                        <i class="bi bi-geo-alt-fill"></i> Showroom KittyPhone Hà Nội
                                    </div>
                                    <div class="small mb-1"><strong>Địa chỉ:</strong> 123 Thái Hà, Phường Trung Liệt, Quận Đống Đa, Hà Nội</div>
                                    <div class="small mb-1"><strong>Thời gian hoạt động:</strong> 08:00 - 21:30 hàng ngày (Cả thứ 7 & Chủ Nhật)</div>
                                    <div class="small text-success"><i class="bi bi-check2-circle me-1"></i>Miễn phí cước giữ hàng trong 48h, KTV hỗ trợ dán cường lực & sao lưu dữ liệu miễn phí.</div>
                                </div>
                            </div>

                            <!-- Home Delivery Section -->
                            <div class="col-12" id="boxHomeDeliverySection">
                                <div class="row g-2 mb-2">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small text-dark">Khu vực / Quận Huyện (Hà Nội):</label>
                                        <select class="form-select form-select-sm" id="cboDistrictQuick" onchange="onDistrictChange()">
                                            <option value="Đống Đa" data-km="1.5">Quận Đống Đa (Cách shop 1.5 km)</option>
                                            <option value="Thanh Xuân" data-km="3.5">Quận Thanh Xuân (Cách shop 3.5 km)</option>
                                            <option value="Cầu Giấy" data-km="5.0" selected>Quận Cầu Giấy (Cách shop 5.0 km)</option>
                                            <option value="Ba Đình" data-km="4.5">Quận Ba Đình (Cách shop 4.5 km)</option>
                                            <option value="Hai Bà Trưng" data-km="4.0">Quận Hai Bà Trưng (Cách shop 4.0 km)</option>
                                            <option value="Hoàn Kiếm" data-km="6.0">Quận Hoàn Kiếm (Cách shop 6.0 km)</option>
                                            <option value="Tây Hồ" data-km="8.0">Quận Tây Hồ (Cách shop 8.0 km)</option>
                                            <option value="Hoàng Mai" data-km="7.5">Quận Hoàng Mai (Cách shop 7.5 km)</option>
                                            <option value="Nam Từ Liêm" data-km="8.5">Quận Nam Từ Liêm (Cách shop 8.5 km)</option>
                                            <option value="Bắc Từ Liêm" data-km="11.0">Quận Bắc Từ Liêm (Cách shop 11.0 km)</option>
                                            <option value="Hà Đông" data-km="10.0">Quận Hà Đông (Cách shop 10.0 km)</option>
                                            <option value="Long Biên" data-km="12.0">Quận Long Biên (Cách shop 12.0 km)</option>
                                            <option value="Gia Lâm" data-km="16.0">Huyện Gia Lâm (Cách shop 16.0 km)</option>
                                            <option value="Đông Anh" data-km="18.0">Huyện Đông Anh (Cách shop 18.0 km)</option>
                                            <option value="Tỉnh khác" data-km="120.0">Tỉnh/Thành phố khác (Toàn quốc bưu cục)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small text-dark">Khoảng cách ước tính:</label>
                                        <div class="input-group input-group-sm">
                                            <input type="number" step="0.5" min="0.5" max="2000" id="txtDistanceKmInput" class="form-control" value="5.0" onchange="onDistanceManualChange()" />
                                            <span class="input-group-text bg-white">km</span>
                                            <button type="button" class="btn btn-outline-primary" onclick="recalculateShipping()"><i class="bi bi-arrow-repeat"></i> Tính cước</button>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Address" class="form-label fw-bold small text-dark">Địa chỉ nhận hàng chi tiết <span class="text-danger">*</span></label>
                                    <input asp-for="Address" id="txtAddressInput" class="form-control" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành..." required />
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>

                                <!-- Shipping Carrier Options Choice -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-bold small text-dark mb-0">
                                            <i class="bi bi-box-seam text-primary me-1"></i>Chọn dịch vụ vận chuyển:
                                        </label>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 11px;">
                                            <i class="bi bi-shield-check me-1"></i>Bảo hiểm 100% giá trị máy
                                        </span>
                                    </div>

                                    <div class="row g-2" id="carrierCardsContainer">
                                        <!-- Carrier 1: Xanh SM Express -->
                                        <div class="col-md-6">
                                            <div class="carrier-option-card selected p-2 border rounded-3 cursor-pointer" data-carrier="xanhsm" data-name="Xanh SM Express" data-fee="0" data-service="Giao hỏa tốc xe máy điện 30 - 60 phút" onclick="selectCarrier(this)">
                                                <div class="d-flex justify-content-between align-items-start mb-1">
                                                    <span class="fw-bold small text-dark"><i class="bi bi-lightning-charge-fill text-success me-1"></i>Xanh SM Express</span>
                                                    <span class="badge bg-success-subtle text-success fee-badge">0đ</span>
                                                </div>
                                                <div class="text-muted" style="font-size: 11px;">Xe máy điện VinFast êm ái, chống sốc cực tốt cho máy. 30 - 60 phút.</div>
                                            </div>
                                        </div>

                                        <!-- Carrier 2: GrabExpress -->
                                        <div class="col-md-6">
                                            <div class="carrier-option-card p-2 border rounded-3 cursor-pointer" data-carrier="grab" data-name="GrabExpress Siêu Tốc" data-fee="5000" data-service="Giao tức thì 30 - 90 phút" onclick="selectCarrier(this)">
                                                <div class="d-flex justify-content-between align-items-start mb-1">
                                                    <span class="fw-bold small text-dark"><i class="bi bi-bicycle text-success me-1"></i>GrabExpress</span>
                                                    <span class="badge bg-light text-dark border fee-badge">5.000đ</span>
                                                </div>
                                                <div class="text-muted" style="font-size: 11px;">Tài xế giao ngay tức thời, cập nhật định vị GPS trực tiếp.</div>
                                            </div>
                                        </div>

                                        <!-- Carrier 3: BeDelivery -->
                                        <div class="col-md-6">
                                            <div class="carrier-option-card p-2 border rounded-3 cursor-pointer" data-carrier="be" data-name="BeDelivery Tiết Kiệm" data-fee="0" data-service="Giao tiết kiệm xe máy 1 - 2 giờ" onclick="selectCarrier(this)">
                                                <div class="d-flex justify-content-between align-items-start mb-1">
                                                    <span class="fw-bold small text-dark"><i class="bi bi-send-fill text-warning me-1"></i>BeDelivery</span>
                                                    <span class="badge bg-success-subtle text-success fee-badge">0đ</span>
                                                </div>
                                                <div class="text-muted" style="font-size: 11px;">Tiết kiệm chi phí, đội ngũ tài xế Be bọc gói cẩn thận.</div>
                                            </div>
                                        </div>

                                        <!-- Carrier 4: Giao Hàng Nhanh (GHN) -->
                                        <div class="col-md-6">
                                            <div class="carrier-option-card p-2 border rounded-3 cursor-pointer" data-carrier="ghn" data-name="Giao Hàng Nhanh (GHN)" data-fee="0" data-service="Chuyển phát bưu cục 1 - 2 ngày" onclick="selectCarrier(this)">
                                                <div class="d-flex justify-content-between align-items-start mb-1">
                                                    <span class="fw-bold small text-dark"><i class="bi bi-box-seam-fill text-primary me-1"></i>Giao Hàng Nhanh</span>
                                                    <span class="badge bg-success-subtle text-success fee-badge">0đ</span>
                                                </div>
                                                <div class="text-muted" style="font-size: 11px;">Mạng lưới bưu cục rộng khắp, tra cứu tracking bưu phẩm dễ dàng.</div>
                                            </div>
                                        </div>

                                        <!-- Carrier 5: Viettel Post -->
                                        <div class="col-md-12">
                                            <div class="carrier-option-card p-2 border rounded-3 cursor-pointer" data-carrier="viettelpost" data-name="Viettel Post Toàn Quốc" data-fee="0" data-service="Chuyển phát bưu tá toàn quốc 2 - 3 ngày" onclick="selectCarrier(this)">
                                                <div class="d-flex justify-content-between align-items-start mb-1">
                                                    <span class="fw-bold small text-dark"><i class="bi bi-shield-shaded text-danger me-1"></i>Viettel Post Toàn Quốc</span>
                                                    <span class="badge bg-success-subtle text-success fee-badge">0đ</span>
                                                </div>
                                                <div class="text-muted" style="font-size: 11px;">Giao tận tay bưu tá quân đội, phủ sóng 63 tỉnh thành & huyện đảo.</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-text mt-2 text-primary" style="font-size: 11px;">
                                        <i class="bi bi-info-circle-fill me-1"></i>KittyPhone tài trợ tối đa 35.000đ cước ship cho mọi đơn hàng điện thoại từ 5 triệu.
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="OrderNotes" class="form-label fw-bold small text-dark">Ghi chú đơn hàng (Tuỳ chọn)</label>
                                <textarea asp-for="OrderNotes" class="form-control" rows="2" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi đến..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Method Choice Card -->
                    <div class="bg-white p-4 rounded-3 border shadow-sm">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                            <i class="bi bi-credit-card-2-back-fill text-primary me-2"></i>2. CHỌN PHƯƠNG THỨC THANH TOÁN
                        </h6>

                        <!-- Option 1: COD with 50% deposit -->
                        <div class="payment-option-card selected mb-3" id="cardCod">
                            <div class="form-check d-flex align-items-center gap-2">
                                <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="COD" id="payCod" checked>
                                <label class="form-check-label fw-bold text-dark cursor-pointer" for="payCod">
                                    <i class="bi bi-cash-stack text-success me-1"></i>Thanh toán khi nhận hàng (COD) - Cọc trước 50%
                                </label>
                            </div>
                            <div class="mt-2 ps-4 text-muted small">
                                <div class="deposit-notice-badge my-2">
                                    <i class="bi bi-info-circle-fill me-1"></i>
                                    Do thiết bị công nghệ là mặt hàng giá trị cao, quý khách vui lòng <strong>chuyển khoản cọc trước 50% (<span id="txtDeposit50">@Model.MinimumDeposit.ToString("N0")</span>đ)</strong>. Số tiền còn lại (<span id="txtRemaining50">@Model.CodRemaining.ToString("N0")</span>đ) sẽ thanh toán khi nhận máy.
                                </div>
                            </div>
                        </div>

                        <!-- Option 2: Full Bank Transfer -->
                        <div class="payment-option-card mb-3" id="cardBank">
                            <div class="form-check d-flex align-items-center gap-2">
                                <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="BankTransfer" id="payBank">
                                <label class="form-check-label fw-bold text-dark cursor-pointer" for="payBank">
                                    <i class="bi bi-qr-code-scan text-primary me-1"></i>Chuyển khoản thanh toán 100% (VietQR / ZaloPay)
                                </label>
                            </div>
                            <div class="mt-2 ps-4 text-muted small">
                                Thanh toán toàn bộ 100% qua mã QR ngân hàng hoặc ZaloPay. Đơn hàng sẽ được duyệt và xuất kho giao siêu tốc ngay sau khi nhận tiền.
                            </div>

                            <!-- Live Dynamic ZaloPay QR Preview Box -->
                            <div class="mt-3 ps-4" id="boxBankQrPreview" style="display: none;">
                                <div class="p-3 rounded-3 border bg-white d-flex flex-wrap gap-3 align-items-center">
                                    <div class="bg-light p-2 rounded border shadow-sm text-center">
                                        <img id="imgCheckoutBankQr" 
                                             src="https://img.vietqr.io/image/970454-0396166509-compact2.png?amount=@((long)Model.TotalAmount)&addInfo=@(Uri.EscapeDataString("KITTYPHONE DAT HANG"))&accountName=DUONG%20NGOC%20ANH" 
                                             alt="Mã QR Chuyển khoản ZaloPay" 
                                             class="img-fluid rounded" 
                                             style="max-width: 170px; height: auto;" />
                                        <div class="small text-muted mt-1" style="font-size: 0.72rem;"><i class="bi bi-camera me-1"></i>ZaloPay / App Bank</div>
                                    </div>
                                    <div class="flex-fill small">
                                        <div class="fw-bold text-primary mb-1">
                                            <i class="bi bi-wallet2 me-1"></i>TÀI KHOẢN ZALOPAY / VIETQR
                                        </div>
                                        <div class="mb-1"><span class="text-muted">Ngân hàng / Ví:</span> <strong class="text-dark">ZaloPay / VietQR</strong></div>
                                        <div class="mb-1"><span class="text-muted">Số tài khoản:</span> <strong class="text-primary font-monospace fs-6">0396166509</strong></div>
                                        <div class="mb-1"><span class="text-muted">Chủ tài khoản:</span> <strong class="text-dark">DUONG NGOC ANH</strong></div>
                                        <div class="mb-1"><span class="text-muted">Số tiền thanh toán:</span> <strong class="text-danger fs-6" id="txtCheckoutBankQrAmount">@Model.TotalAmount.ToString("N0")đ</strong></div>
                                        <div class="text-success fw-semibold mt-1" style="font-size: 0.76rem;">
                                            <i class="bi bi-check-circle me-1"></i>Mã QR tự động cập nhật đúng số tiền sau khi áp dụng Voucher & Phí Ship!
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Option 3: Installment 0% -->
                        <div class="payment-option-card mb-2" id="cardInstallment">
                            <div class="form-check d-flex align-items-center gap-2">
                                <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="Installment" id="payInstallment">
                                <label class="form-check-label fw-bold text-dark cursor-pointer" for="payInstallment">
                                    <i class="bi bi-percent text-primary me-1"></i>Trả góp 0% Lãi Suất (Duyệt hồ sơ online tiện lợi)
                                </label>
                            </div>
                            <div class="mt-2 ps-4 small" id="boxInstallmentDetails" style="display: none;">
                                <p class="text-muted mb-2">Hỗ trợ trả góp 0% qua công ty tài chính hoặc thẻ tín dụng. Vui lòng chọn tỷ lệ trả trước và kỳ hạn:</p>

                                <!-- Prepay percent buttons -->
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-dark small mb-1">Mức trả trước:</label>
                                    <div class="d-flex gap-2">
                                        <input type="hidden" asp-for="InstallmentPrepayPercent" id="inputPrepayPercent" value="30" />
                                        <button type="button" class="btn btn-outline-primary btn-sm flex-fill btn-prepay active" data-percent="30">Trả trước 30%</button>
                                        <button type="button" class="btn btn-outline-primary btn-sm flex-fill btn-prepay" data-percent="50">Trả trước 50%</button>
                                        <button type="button" class="btn btn-outline-primary btn-sm flex-fill btn-prepay" data-percent="70">Trả trước 70%</button>
                                    </div>
                                </div>

                                <!-- Months term buttons -->
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-dark small mb-1">Kỳ hạn trả góp:</label>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <input type="hidden" asp-for="InstallmentMonths" id="inputInstallmentMonths" value="6" />
                                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill btn-term" data-months="3">3 Tháng</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill btn-term active" data-months="6">6 Tháng</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill btn-term" data-months="9">9 Tháng</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill btn-term" data-months="12">12 Tháng</button>
                                    </div>
                                </div>

                                <!-- Calculation result box -->
                                <div class="p-3 rounded-3 border" style="background: #f8fafc;">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Tiền trả trước khi nhận máy:</span>
                                        <strong class="text-primary fs-6" id="txtPrepayAmount">0đ</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Khoản vay còn lại trả góp:</span>
                                        <strong class="text-dark" id="txtLoanAmount">0đ</strong>
                                    </div>
                                    <div class="d-flex justify-content-between border-top pt-2 mt-2">
                                        <span class="fw-bold text-dark">Góp mỗi tháng (0% lãi suất):</span>
                                        <strong class="text-primary fs-5" id="txtMonthlyAmount">0đ / tháng</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Order items summary & Submit -->
                <div class="col-lg-5">
                    <div class="bg-white p-4 rounded-3 border shadow-sm cps-checkout-sticky-card">
                        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center">
                                <i class="bi bi-cart-check-fill text-primary me-2"></i>ĐƠN HÀNG (@Model.CartItems.Sum(c => c.Quantity) MÓN)
                            </h6>
                            <a asp-action="Index" class="small text-primary fw-semibold text-decoration-none">
                                <i class="bi bi-pencil-square me-1"></i>Sửa
                            </a>
                        </div>

                        <div class="mb-3 max-height-cart overflow-auto pe-1" style="max-height: 230px;">
                            @foreach (var item in Model.CartItems)
                            {
                                <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder-phone.svg" : item.ImageUrl)" 
                                             style="width: 46px; height: 46px; object-fit: contain;" 
                                             class="border rounded p-1 bg-white" 
                                             onerror="this.onerror=null;this.src='/images/placeholder-phone.svg';" />
                                        <div>
                                            <div class="fw-bold text-dark small" style="line-height: 1.3;">@item.ProductName</div>
                                            <span class="text-muted small" style="font-size: 11px;">Số lượng: @item.Quantity</span>
                                        </div>
                                    </div>
                                    <div class="fw-bold text-primary text-end small">@item.LineTotal.ToString("N0")đ</div>
                                </div>
                            }
                        </div>

                        <input type="hidden" asp-for="SubTotal" id="hdnSubTotal" />
                        <input type="hidden" asp-for="DiscountAmount" id="hdnDiscountAmount" value="0" />
                        <input type="hidden" asp-for="DiscountPercent" id="hdnDiscountPercent" value="0" />

                        <!-- Khuyến mãi & Voucher KittyPhone -->
                        <div class="mb-3 p-3 rounded-3 border" style="background: #f8fafc; border-color: #e2e8f0 !important;">
                            <label class="form-label fw-bold small text-dark d-flex align-items-center justify-content-between mb-2">
                                <span><i class="bi bi-tag-fill text-danger me-1"></i>Mã khuyến mãi / Voucher</span>
                                <span class="badge bg-danger-subtle text-danger" style="font-size: 11px;">Ưu đãi hôm nay</span>
                            </label>
                            
                            @if (Model.AvailablePromotions != null && Model.AvailablePromotions.Count > 0)
                            {
                                <select asp-for="PromotionId" class="form-select form-select-sm" id="cboPromotion">
                                    <option value="" data-percent="0">-- Chọn chương trình khuyến mãi --</option>
                                    @foreach (var promo in Model.AvailablePromotions)
                                    {
                                        string tag = "";
                                        if (promo.StartHour.HasValue && promo.EndHour.HasValue) tag = $"[Giờ vàng {promo.StartHour:00}:00 - {promo.EndHour:00}:00] ";
                                        else if (promo.MinRankId.HasValue && promo.MinRankId > 1) tag = "[Hội viên Bạc/Vàng+] ";
                                        else if (promo.StartDate.Date == promo.EndDate.Date) tag = "[Duy nhất 20/10] ";
                                        else tag = "[18/10 - 20/10] ";

                                        <option value="@promo.PromotionId" data-percent="@promo.DiscountPercent" data-desc="@promo.Description">
                                            🎁 @tag@promo.PromotionName (-@promo.DiscountPercent.ToString("0.#")%)
                                        </option>
                                    }
                                </select>
                                <div id="promoErrorBox" class="alert alert-danger py-2 px-3 small mt-2 mb-0 rounded-3 shadow-sm" style="display: none; font-size: 12px;">
                                    <i class="bi bi-exclamation-octagon-fill me-1"></i><span id="promoErrorText"></span>
                                </div>
                                <div id="promoDescriptionBox" class="mt-2 small text-muted fst-italic" style="display: none; font-size: 11px;">
                                    <i class="bi bi-info-circle text-primary me-1"></i><span id="promoDescriptionText"></span>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small">Hiện chưa có mã khuyến mãi khả dụng.</div>
                            }
                        </div>

                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Tổng tiền hàng:</span>
                            <span class="fw-bold text-dark" id="txtSubTotal">@Model.SubTotal.ToString("N0")đ</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2 small text-danger" id="rowDiscount" style="display: none !important;">
                            <span><i class="bi bi-gift-fill me-1"></i>Chiết khấu khuyến mãi (<span id="txtDiscountPercent">0</span>%):</span>
                            <span class="fw-bold" id="txtDiscountAmount">-0đ</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="fw-bold text-success" id="txtShippingFeeDisplay">Miễn phí giao hàng</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-baseline border-top pt-3 mb-3">
                            <span class="fw-bold fs-6 text-dark">Tổng thanh toán:</span>
                            <span class="fw-bold fs-4 text-primary" id="txtFinalTotal">@Model.TotalAmount.ToString("N0")đ</span>
                        </div>

                        <!-- Dynamic payment note -->
                        <div class="p-3 rounded-3 mb-3 border" id="summaryNoticeBox" style="background: #f0f9ff; border-color: #bae6fd !important;">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-muted" id="summaryDepositLabel">Mức cọc cần thanh toán (50%):</span>
                                <strong class="text-primary" id="summaryDepositValue">@Model.MinimumDeposit.ToString("N0")đ</strong>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted" id="summaryRemainingLabel">Còn lại khi nhận hàng:</span>
                                <strong class="text-dark" id="summaryRemainingValue">@Model.CodRemaining.ToString("N0")đ</strong>
                            </div>
                        </div>

                        <button type="submit" class="btn text-white btn-lg w-100 fw-bold py-3 shadow-sm rounded-3 text-uppercase" style="background: linear-gradient(135deg, #0e2254, #0284c7); border: none; font-size: 15px; letter-spacing: 0.5px;">
                            ĐẶT HÀNG NGAY
                        </button>

                        <div class="text-center mt-3 small text-muted">
                            <i class="bi bi-shield-check me-1 text-success"></i>Bảo vệ quyền lợi khách hàng 100% tại KittyPhone
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    .delivery-method-card {
        transition: all 0.2s ease;
        background: #f8fafc;
        border-color: #e2e8f0 !important;
    }
    .delivery-method-card:hover {
        border-color: #0284c7 !important;
        background: #f0f9ff;
    }
    .delivery-method-card.active {
        border-color: #0284c7 !important;
        background: #f0f9ff;
        box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.15);
    }
    .carrier-option-card {
        transition: all 0.2s ease;
        background: #ffffff;
        border-color: #e2e8f0 !important;
    }
    .carrier-option-card:hover {
        border-color: #0284c7 !important;
        background: #f8fafc;
    }
    .carrier-option-card.selected {
        border-color: #0284c7 !important;
        background: #f0f9ff;
        box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.2);
    }
</style>

@section Scripts {
<script>
    let subTotalAmount = @Model.SubTotal;
    let discountAmount = 0;
    let shippingFeeAmount = 0;
    let currentTotal = @Model.TotalAmount;

    function formatVND(num) {
        return Math.round(num).toLocaleString('vi-VN') + 'đ';
    }

    function selectDeliveryMethod(method) {
        $('#hdnDeliveryMethod').val(method);
        if (method === 'StorePickup') {
            $('#btnMethodStore').addClass('active');
            $('#btnMethodHome').removeClass('active');
            $('#boxStorePickupDetails').slideDown();
            $('#boxHomeDeliverySection').slideUp();

            // Store pickup = 0 ship
            shippingFeeAmount = 0;
            $('#hdnShippingFee').val(0);
            $('#hdnShippingCarrier').val('store_pickup');
            $('#hdnShippingCarrierName').val('Nhận tại cửa hàng');
            $('#hdnShippingServiceType').val('Nhận trực tiếp tại showroom 123 Thái Hà');
            $('#txtShippingFeeDisplay').html('<span class="text-success fw-bold">0đ (Tại cửa hàng)</span>');
            recalculateGrandTotal();
        } else {
            $('#btnMethodHome').addClass('active');
            $('#btnMethodStore').removeClass('active');
            $('#boxStorePickupDetails').slideUp();
            $('#boxHomeDeliverySection').slideDown();

            // Restore selected carrier
            const activeCard = $('.carrier-option-card.selected');
            if (activeCard.length > 0) {
                selectCarrier(activeCard[0]);
            } else {
                recalculateShipping();
            }
        }
    }

    function selectCarrier(element) {
        $('.carrier-option-card').removeClass('selected');
        $(element).addClass('selected');

        const carrier = $(element).data('carrier');
        const name = $(element).data('name');
        const fee = parseFloat($(element).data('fee')) || 0;
        const service = $(element).data('service');

        $('#hdnShippingCarrier').val(carrier);
        $('#hdnShippingCarrierName').val(name);
        $('#hdnShippingFee').val(fee);
        $('#hdnShippingServiceType').val(service);

        shippingFeeAmount = fee;
        if (fee === 0) {
            $('#txtShippingFeeDisplay').html('<span class="text-success fw-bold">Miễn phí giao hàng</span>');
        } else {
            $('#txtShippingFeeDisplay').html('<span class="text-dark fw-bold">' + formatVND(fee) + '</span>');
        }

        recalculateGrandTotal();
    }

    function onDistrictChange() {
        const sel = $('#cboDistrictQuick option:selected');
        const km = parseFloat(sel.data('km')) || 5.0;
        const districtName = sel.val();
        $('#txtDistanceKmInput').val(km);
        $('#hdnShippingDistanceKm').val(km);

        const currentAddr = $('#txtAddressInput').val();
        if (!currentAddr || currentAddr.indexOf('Hà Nội') < 0) {
            if (districtName === 'Tỉnh khác') {
                $('#txtAddressInput').val('TP. Hồ Chí Minh / Tỉnh thành');
            } else {
                $('#txtAddressInput').val('Quận ' + districtName + ', Hà Nội');
            }
        }
        recalculateShipping();
    }

    function onDistanceManualChange() {
        const km = parseFloat($('#txtDistanceKmInput').val()) || 5.0;
        $('#hdnShippingDistanceKm').val(km);
        recalculateShipping();
    }

    function recalculateShipping() {
        if ($('#hdnDeliveryMethod').val() === 'StorePickup') return;

        const distance = parseFloat($('#txtDistanceKmInput').val()) || 5.0;
        const address = $('#txtAddressInput').val() || 'Hà Nội';
        const netValue = Math.max(0, subTotalAmount - discountAmount);

        // Gọi API CalculateShipping
        $.ajax({
            url: '/Customer/CalculateShipping',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                customerAddress: address,
                distanceKm: distance,
                weightKg: 0.8,
                packageValue: netValue,
                orderType: 'sale'
            }),
            success: function(res) {
                if (res && res.options && res.options.length > 0) {
                    renderCarrierOptions(res.options);
                }
            },
            error: function() {
                console.log('Không thể tải cước shipping động, dùng cấu hình mặc định.');
            }
        });
    }

    function renderCarrierOptions(options) {
        const container = $('#carrierCardsContainer');
        const currentCarrier = $('#hdnShippingCarrier').val();
        container.empty();

        let foundSelected = false;

        options.forEach(function(opt) {
            const isSelected = (!foundSelected && (opt.carrierCode === currentCarrier || !currentCarrier));
            if (isSelected) foundSelected = true;

            const feeBadge = opt.finalFee === 0 
                ? '<span class="badge bg-success-subtle text-success fee-badge">0đ (Freeship)</span>'
                : '<span class="badge bg-light text-dark border fee-badge">' + formatVND(opt.finalFee) + '</span>';

            const subsidyNote = opt.storeSubsidy > 0 
                ? '<span class="text-success ms-1"><i class="bi bi-tag-fill"></i> Trợ giá ' + formatVND(opt.storeSubsidy) + '</span>'
                : '';

            const col = $(`
                <div class="col-md-6">
                    <div class="carrier-option-card ${isSelected ? 'selected' : ''} p-2 border rounded-3 cursor-pointer"
                         data-carrier="${opt.carrierCode}"
                         data-name="${opt.carrierName}"
                         data-fee="${opt.finalFee}"
                         data-service="${opt.serviceType}"
                         onclick="selectCarrier(this)">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="fw-bold small text-dark">${opt.carrierName}</span>
                            ${feeBadge}
                        </div>
                        <div class="text-muted" style="font-size: 11px;">
                            ${opt.estimatedTime} • ${opt.serviceType} ${subsidyNote}
                        </div>
                    </div>
                </div>
            `);
            container.append(col);

            if (isSelected) {
                selectCarrier(col.find('.carrier-option-card')[0]);
            }
        });
    }

    function recalculateGrandTotal() {
        currentTotal = Math.max(0, subTotalAmount - discountAmount) + shippingFeeAmount;
        $('#txtFinalTotal').text(formatVND(currentTotal));
        updatePaymentSummary();
    }

    function updatePaymentSummary() {
        const val = $('input[name="PaymentMethod"]:checked').val();
        if (val === 'COD') {
            $('#boxBankQrPreview').slideUp();
            $('#summaryDepositLabel').text('Mức cọc cần thanh toán (50%):');
            const dep = Math.round(currentTotal * 0.5 / 10000) * 10000;
            $('#summaryDepositValue').text(formatVND(dep));
            $('#summaryRemainingLabel').text('Còn lại khi nhận hàng:');
            $('#summaryRemainingValue').text(formatVND(currentTotal - dep));
            $('#txtDeposit50').text(formatVND(dep).replace('đ', ''));
            $('#txtRemaining50').text(formatVND(currentTotal - dep).replace('đ', ''));
        } else if (val === 'BankTransfer') {
            $('#boxBankQrPreview').slideDown();
            const qrUrl = 'https://img.vietqr.io/image/970454-0396166509-compact2.png?amount=' + Math.round(currentTotal) + '&addInfo=' + encodeURIComponent('KITTYPHONE DAT HANG') + '&accountName=DUONG%20NGOC%20ANH';
            $('#imgCheckoutBankQr').attr('src', qrUrl);
            $('#txtCheckoutBankQrAmount').text(formatVND(currentTotal));

            $('#summaryDepositLabel').text('Thanh toán toàn bộ (100%):');
            $('#summaryDepositValue').text(formatVND(currentTotal));
            $('#summaryRemainingLabel').text('Còn lại khi nhận hàng:');
            $('#summaryRemainingValue').text('0đ (Đã thanh toán đủ)');
        } else if (val === 'Installment') {
            $('#boxBankQrPreview').slideUp();
            calculateInstallment();
        }
    }

    function calculateInstallment() {
        const prepayPercent = parseInt($('#inputPrepayPercent').val()) || 30;
        const months = parseInt($('#inputInstallmentMonths').val()) || 6;

        const prepayAmount = Math.round(currentTotal * (prepayPercent / 100) / 10000) * 10000;
        const loanAmount = Math.max(0, currentTotal - prepayAmount);
        const monthlyAmount = months > 0 ? Math.round(loanAmount / months / 1000) * 1000 : 0;

        $('#txtPrepayAmount').text(formatVND(prepayAmount));
        $('#txtLoanAmount').text(formatVND(loanAmount));
        $('#txtMonthlyAmount').text(formatVND(monthlyAmount) + ' / tháng');

        if ($('input[name="PaymentMethod"]:checked').val() === 'Installment') {
            $('#summaryDepositLabel').text('Tiền trả trước (' + prepayPercent + '%):');
            $('#summaryDepositValue').text(formatVND(prepayAmount));
            $('#summaryRemainingLabel').text('Góp mỗi tháng (' + months + ' tháng):');
            $('#summaryRemainingValue').text(formatVND(monthlyAmount) + ' / tháng');
        }
    }

    $('#cboPromotion').change(function() {
        const promoId = $(this).val();
        $('#promoErrorBox').hide();

        if (!promoId) {
            discountAmount = 0;
            $('#hdnDiscountAmount').val(0);
            $('#hdnDiscountPercent').val(0);
            $('#rowDiscount').hide();
            $('#promoDescriptionBox').slideUp();
            recalculateGrandTotal();
            recalculateShipping();
            return;
        }

        // Gọi API backend kiểm tra ràng buộc khung giờ & hạng thành viên
        $.get('/Cart/CalculateDiscount', { promotionId: promoId, subTotal: subTotalAmount }, function(res) {
            if (res.success) {
                discountAmount = res.discountAmount;
                $('#hdnDiscountAmount').val(res.discountAmount);
                $('#hdnDiscountPercent').val(res.discountPercent);
                $('#txtDiscountPercent').text(res.discountPercent);
                $('#txtDiscountAmount').text('-' + formatVND(res.discountAmount));
                $('#rowDiscount').show();

                const desc = $('#cboPromotion option:selected').data('desc');
                if (desc) {
                    $('#promoDescriptionText').text(desc);
                    $('#promoDescriptionBox').slideDown();
                } else {
                    $('#promoDescriptionBox').slideUp();
                }
            } else {
                // Không thỏa mãn điều kiện ràng buộc
                $('#promoErrorText').text(res.message);
                $('#promoErrorBox').slideDown();
                $('#promoDescriptionBox').slideUp();

                discountAmount = 0;
                $('#hdnDiscountAmount').val(0);
                $('#hdnDiscountPercent').val(0);
                $('#rowDiscount').hide();
            }
            recalculateGrandTotal();
            recalculateShipping();
        }).fail(function() {
            $('#promoErrorText').text('Lỗi kiểm tra mã khuyến mãi. Vui lòng thử lại.');
            $('#promoErrorBox').slideDown();
        });
    });

    $('input[name="PaymentMethod"]').change(function() {
        const val = $(this).val();
        $('.payment-option-card').removeClass('selected');
        if (val === 'COD') {
            $('#cardCod').addClass('selected');
            $('#boxInstallmentDetails').slideUp();
        } else if (val === 'BankTransfer') {
            $('#cardBank').addClass('selected');
            $('#boxInstallmentDetails').slideUp();
        } else if (val === 'Installment') {
            $('#cardInstallment').addClass('selected');
            $('#boxInstallmentDetails').slideDown();
        }
        updatePaymentSummary();
    });

    $('.btn-prepay').click(function() {
        $('.btn-prepay').removeClass('active');
        $(this).addClass('active');
        $('#inputPrepayPercent').val($(this).data('percent'));
        calculateInstallment();
    });

    $('.btn-term').click(function() {
        $('.btn-term').removeClass('active btn-primary').addClass('btn-outline-secondary');
        $(this).removeClass('btn-outline-secondary').addClass('active btn-primary');
        $('#inputInstallmentMonths').val($(this).data('months'));
        calculateInstallment();
    });

    // Khởi tạo tính cước khi load trang
    $(document).ready(function() {
        recalculateShipping();
        updatePaymentSummary();
    });
</script>
}
